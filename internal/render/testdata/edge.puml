@startuml
title edge
[*] --> a
state a
a : entry / log('hi')
state p {
    [*] --> r1a
    state r1a
    --
    [*] --> r2a
    state r2a
}
state b {
    [*] --> b1
    state h <<history*>>
    state b1
    state f <<end>>
    h --> b1
    b1 --> f: x
}
a --> p: go
a --> a: multi
a --> b: multi
p --> h: done
@enduml
