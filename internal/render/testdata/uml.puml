@startuml
title uml
note as machineNote
    Every UML concept the model holds,
    in one document.
end note
legend
    retries = 0
    config = src(config.json)
endlegend
[*] --> check
state check <<choice>>
state split <<fork>>
state merge <<start>>
state sync <<join>>
state "«worker»\nwork" as work <<worker>>
work : entry / log('start')
work : do / invoke(job.py, http://example.com/worker)
work : pause / defer
work : resume / defer
work : [ retries >= 0 ]
work : progress = 0
note right of work
    Runs the job.
    entry: Starts the clock.
    do: Runs in a worker.
    pause / defer: Kept until the job ends.
    invariant: Never negative.
end note
state both {
    state left
    --
    state right
}
state "sub: child.scxml" as sub
state outer {
    [*] --> inner: / log('hi')
    state in <<entryPoint>>
    state out <<exitPoint>>
    state inner
    in --> inner
    inner --> out: leave
    inner --> inner: again
    inner : note
}
outer : exit / log('bye')
note right of outer : exit: Says goodbye.
state stop <<end>>
state done <<end>>
state failed <<end>>
check --> failed: [ retries > 3 ]
check --> work: [ retries <= 3 ]
split --> left
merge --> work
sync --> done
work --> check: after(5s)\n/ retries = retries + 1
note on link : Timed out.
work --> check: after(retryDelay)
work --> split: split
work --> stop: abort
work --> in: enter
left --> sync: l
sub --> merge: back
sub --> done
outer --> done
out --> sub
@enduml
