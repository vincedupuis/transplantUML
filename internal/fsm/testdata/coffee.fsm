# A coffee machine in the fsm language.
fsm coffee {
    initial state idle {
        entry / beep
        on coin goto brewing
    }
    state brewing {
        do / heat
        on cancel goto brewing
        on restart goto local heating
        on error goto final
        initial state heating {
            on hot goto pouring
        }
        on resume goto H
        state pouring {
            on done [not empty and (cup or mug)] / pour goto idle
            on tick / count
            on coin / defer
        }
        exit / log, reset
    }
}
