<?xml version="1.0" encoding="UTF-8"?>
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" name="edge" initial="a">
  <state id="a">
    <onentry>
      <script>log('hi')</script>
    </onentry>
    <transition event="go" target="p"/>
    <transition event="multi" target="a b"/>
  </state>
  <parallel id="p">
    <transition event="done" target="h"/>
    <state id="r1" initial="r1a">
      <state id="r1a"/>
    </state>
    <state id="r2" initial="r2a">
      <state id="r2a"/>
    </state>
  </parallel>
  <state id="b" initial="b1">
    <history id="h" type="deep">
      <transition target="b1"/>
    </history>
    <state id="b1">
      <transition event="x" target="f"/>
    </state>
    <final id="f"/>
  </state>
</scxml>
