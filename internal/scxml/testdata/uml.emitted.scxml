<?xml version="1.0" encoding="UTF-8"?>
<scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:tpuml="https://github.com/vincedupuis/transplantUML" version="1.0" name="uml" initial="check">
  <datamodel>
    <data id="retries" expr="0"/>
    <data id="config" src="config.json"/>
  </datamodel>
  <tpuml:note>Every UML concept the model holds,
in one document.</tpuml:note>
  <state id="check" tpuml:kind="choice">
    <transition cond="retries > 3" target="failed"/>
    <transition cond="retries &lt;= 3" target="work"/>
  </state>
  <state id="split" tpuml:kind="fork">
    <transition target="left right"/>
  </state>
  <state id="merge" tpuml:kind="junction">
    <transition target="work"/>
  </state>
  <state id="sync" tpuml:kind="join">
    <transition target="done"/>
  </state>
  <state id="work" tpuml:stereotype="worker" tpuml:invariant="retries >= 0" tpuml:defer="pause resume">
    <tpuml:note>Runs the job.</tpuml:note>
    <tpuml:note about="entry">Starts the clock.</tpuml:note>
    <tpuml:note about="do">Runs in a worker.</tpuml:note>
    <tpuml:note about="invariant">Never negative.</tpuml:note>
    <tpuml:note about="defer" event="pause">Kept until the job ends.</tpuml:note>
    <datamodel>
      <data id="progress" expr="0"/>
    </datamodel>
    <onentry>
      <script>log('start')</script>
      <send event="after.5s" delay="5s" id="work.after.5s"/>
      <send event="after.retryDelay" delayexpr="retryDelay" id="work.after.retryDelay"/>
    </onentry>
    <onexit>
      <cancel sendid="work.after.5s"/>
      <cancel sendid="work.after.retryDelay"/>
    </onexit>
    <invoke type="http://example.com/worker" src="job.py"/>
    <transition event="after.5s" target="check">
      <tpuml:note>Timed out.</tpuml:note>
      <script>retries = retries + 1</script>
    </transition>
    <transition event="after.retryDelay" target="check"/>
    <transition event="split" target="split"/>
    <transition event="abort" target="stop"/>
    <transition event="enter" target="in"/>
  </state>
  <parallel id="both">
    <state id="left">
      <transition event="l" target="sync"/>
    </state>
    <state id="right">
      <transition event="r" target="sync"/>
    </state>
  </parallel>
  <state id="sub">
    <invoke id="sub.submachine" src="child.scxml"/>
    <transition event="back" target="merge"/>
    <transition event="done.invoke.sub.submachine" target="done"/>
  </state>
  <state id="outer">
    <initial>
      <transition target="inner">
        <script>log('hi')</script>
      </transition>
    </initial>
    <tpuml:note about="exit">Says goodbye.</tpuml:note>
    <onexit>
      <script>log('bye')</script>
    </onexit>
    <transition event="done.state.outer" target="done"/>
    <state id="in" tpuml:kind="entry-point">
      <transition target="inner"/>
    </state>
    <state id="out" tpuml:kind="exit-point">
      <transition target="sub"/>
    </state>
    <state id="inner">
      <transition event="leave" target="out"/>
      <transition event="again" target="inner" tpuml:kind="local"/>
      <transition event="note" type="internal">
        <tpuml:note>Not drawn.</tpuml:note>
      </transition>
    </state>
  </state>
  <final id="stop" tpuml:kind="terminate"/>
  <final id="done"/>
  <final id="failed"/>
</scxml>
