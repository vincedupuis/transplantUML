<scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:tpuml="https://github.com/vincedupuis/transplantUML"
       version="1.0" name="uml" initial="start">
  <tpuml:note>Every UML concept the model holds,
in one document.</tpuml:note>
  <datamodel>
    <data id="retries" expr="0"/>
    <data id="config" src="config.json"/>
  </datamodel>

  <!-- <scxml> takes no <initial> element: the effect of the machine's initial
       transition sits in a transient state marked as the initial one. -->
  <state id="start" tpuml:kind="initial">
    <transition target="check"><script>boot</script></transition>
  </state>

  <!-- A transient state branching on guards is a choice. -->
  <state id="check">
    <transition cond="tooManyRetries" target="failed"/>
    <transition cond="not tooManyRetries" target="work"/>
  </state>

  <!-- A transient state with one multi-target transition is a fork. -->
  <state id="split">
    <transition target="left right"/>
  </state>

  <!-- Explicit kinds for what SCXML has no idiom for. -->
  <state id="merge" tpuml:kind="junction">
    <transition target="work"/>
  </state>
  <state id="sync" tpuml:kind="join">
    <transition target="done"/>
  </state>

  <state id="work" tpuml:stereotype="worker" tpuml:defer="pause resume" tpuml:invariant="counting and not (stalled or aborted)">
    <tpuml:note>Runs the job.</tpuml:note>
    <!-- Notes on what a state lists say what they are about. -->
    <tpuml:note about="entry">Starts the clock.</tpuml:note>
    <tpuml:note about="do">Runs in a worker.</tpuml:note>
    <tpuml:note about="invariant">Never negative.</tpuml:note>
    <tpuml:note about="defer" event="pause">Kept until the job ends.</tpuml:note>
    <datamodel>
      <data id="progress" expr="0"/>
    </datamodel>
    <onentry>
      <script>startClock</script>
      <send event="tick" delay="5s" id="workTimer"/>
      <send event="retry" delayexpr="retryDelay" id="retryTimer"/>
    </onentry>
    <onexit>
      <cancel sendid="workTimer"/>
      <cancel sendid="retryTimer"/>
    </onexit>
    <invoke type="http://example.com/worker" src="runJob"/>
    <transition event="tick" target="check">
      <tpuml:note>Timed out.</tpuml:note>
      <script>countRetry</script>
    </transition>
    <transition event="retry" target="check"/>
    <transition event="split" target="split"/>
    <transition event="abort" target="stop"/>
    <transition event="enter" target="in"/>
  </state>

  <parallel id="both">
    <state id="left"><transition event="l" target="sync"/></state>
    <state id="right"><transition event="r" target="sync"/></state>
  </parallel>

  <state id="sub">
    <invoke id="helper" src="child"/>
    <transition event="back" target="merge"/>
    <transition event="done.invoke.helper" target="done"/>
  </state>

  <state id="outer">
    <initial><transition target="inner"><script>greet</script></transition></initial>
    <tpuml:note about="exit">Says goodbye.</tpuml:note>
    <onexit><script>sayBye</script></onexit>
    <transition event="done.state.outer" target="done"/>
    <transition event="again" target="inner" type="internal"/>
    <state id="in" tpuml:kind="entry-point"><transition target="inner"/></state>
    <state id="out" tpuml:kind="exit-point"><transition target="sub"/></state>
    <state id="inner">
      <transition event="leave" target="out"/>
      <transition event="note" type="internal"><tpuml:note>Not drawn.</tpuml:note></transition>
    </state>
  </state>

  <final id="stop" tpuml:kind="terminate"/>
  <final id="done"/>
  <final id="failed"/>
</scxml>
