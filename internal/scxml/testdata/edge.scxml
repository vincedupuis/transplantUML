<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" name="edge">
  <initial><transition target="a"/></initial>
  <state id="a">
    <onentry><log expr="'hi'"/></onentry>
    <transition event="go" target="p"/>
    <transition event="multi" target="a b"/>
  </state>
  <parallel id="p">
    <state id="r1"><state id="r1a"/></state>
    <state id="r2"><state id="r2a"/></state>
    <transition event="done" target="h"/>
  </parallel>
  <state id="b">
    <history id="h" type="deep"><transition target="b1"/></history>
    <state id="b1"><transition event="x" target="f"/></state>
    <final id="f"/>
  </state>
</scxml>
