{{- /*
Boost.SML state machine (https://github.com/boost-ext/sml), as four C++20
files named after the machine, here "kiosk":

  KioskFsmEvents.h   the interface declaring one method per event
  KioskFsmActions.h  the interface declaring the guards and actions, which the
                     user of the state machine implements
  KioskFsm.h         the state machine: a class implementing KioskFsmEvents,
                     built from a KioskFsmActions, and KioskFsmListener, the
                     interface it tells when it ends
  KioskFsm.cpp       its implementation, the only file that includes SML

"." at the top level is the *model.StateMachine. Each file starts with a call
to file, and every emitted line starts with a newline, as in puml.gotmpl.

In KioskFsm.cpp the SML code lives in an anonymous namespace: the events are
empty structs in namespace event, each compound or orthogonal state is a
struct of its own, declared before the struct that uses it, and the machine's
own table is struct machine. SML hands every guard and action the
KioskFsmActions the state machine was built from, so a guard [inStock]
becomes a lambda calling actions.inStock() and an action / addLine one calling
actions.addLine(). Simple states and pseudostates are string-literal states
("idle"_s), final states SML's X.

The machine waits in internal::stopped until enterFsm sends it
internal::enter, or the event of one of its entry points. stopFsm sends
internal::stop, which every state of the machine's table answers by going
back to internal::stopped, so the active states' exit behaviours run; then
it starts again from a new SML machine, as enterFsm does first. Their names keep them apart from
the events' methods. It ends in X or in one of its exit points, which report
tells the listener. A submachine state runs another generated machine, which
the constructor takes: its behaviours enter and stop that machine, and a
listener per submachine state turns what the machine reports into internal
events of this one. That machine may report while this one enters it, so
process queues an event while another is being processed.

A transition table holds the states of one scope, with a parallel state's
regions flattened into its own table, one initial state (*) per region. A
transition is written in the innermost table holding both its ends, after
lifting them out of the scopes it crosses: SML has no transitions into or out
of a composite state's inside, so those leave from, or enter, that composite
state as a whole, with a warning.

Rows are built first and the lambdas declared after, from what the rows use:
a row marks each guard ⟨g:name⟩, action ⟨a:name⟩, event ⟨e:name⟩ and struct
⟨s:name⟩. A lambda would hide the event namespace or a struct of the same
name, so those are then written fully qualified. Rows are joined by ⟪row⟫, and
a comment that precedes no row is carried to the next one, since the table
cannot end on a comma. The interfaces are written last in the template, from
the lambdas the tables declared, but first in the output.
*/ -}}
{{- $fsm := print (include "pascal" .Name) "Fsm" -}}
{{- $events := print $fsm "Events" -}}
{{- $actions := print $fsm "Actions" -}}
{{- $listener := print $fsm "Listener" -}}
{{- $defer := false -}}{{- range States }}{{ if .Defer }}{{ $defer = true }}{{ end }}{{ end -}}
{{- $subs := list -}}{{- range States }}{{ if .Submachine }}{{ $subs = append $subs . }}{{ end }}{{ end -}}
{{- $machines := list -}}{{- range $subs }}{{ $machines = append $machines (include "machineClass" .Submachine) }}{{ end -}}
{{- $machines = uniq $machines | sortAlpha -}}
{{- $entries := list -}}{{- $exits := list -}}
{{- range Children "" -}}
{{- if eq .Kind "entry-point" }}{{ $entries = append $entries .Name }}{{ else if eq .Kind "exit-point" }}{{ $exits = append $exits .Name }}{{ end -}}
{{- end -}}
{{- range splitList "\n" (include "eventIds" .) -}}
{{- if has . (list "enterFsm" "stopFsm") -}}
{{- warn "event %q: its method %s clashes with the one that starts or stops the machine; the files do not compile" . . -}}
{{- end -}}
{{- end -}}
{{- $generated := printf "// Generated by fsm%s. Do not edit." (surround " from the state machine \"" .Name "\"") -}}
{{- $code := include "structs" (dict "scope" "" "actions" $actions) -}}
{{- $body := include "body" (dict "table" "" "actions" $actions) -}}
{{- $code = printf "%s\n\nstruct machine {\n    auto operator()() const {\n%s\n    }\n};" $code ($body | trimPrefix "\n" | indent 8) -}}
{{- /* the ends the machine's table reaches, each an SML state and the listener method report calls for it */ -}}
{{- $ends := list -}}
{{- if regexMatch "(?m)^[ \t]*[^/ \t].*= sml::X,?$" $body }}{{ $ends = append $ends (list "sml::X" "onFinished") }}{{ end -}}
{{- range $exits -}}
{{- if regexMatch (printf "(?m)^[ \t]*[^/ \t].*= %s,?$" (regexQuoteMeta (include "str" .))) $body }}{{ $ends = append $ends (list (include "str" .) (print "onExit" (include "pascal" .))) }}{{ end -}}
{{- end -}}
{{- $internal := list "stopped" "enter" "stop" -}}
{{- range $entries }}{{ $internal = append $internal (print "enter_" (include "entryId" .)) }}{{ end -}}
{{- range regexFindAll "::internal::[A-Za-z0-9_]+" $code -1 }}{{ $internal = append $internal (trimPrefix "::internal::" .) }}{{ end -}}
{{- $internal = uniq $internal -}}
{{- /* how the state machine processes an event, %s standing for it */ -}}
{{- $process := "machine_->sm.process_event(%s);" -}}
{{- if $subs }}{{ $process = "machine_->process(%s)" }}{{ end -}}
{{- if and $subs $ends }}{{ $process = printf "if (%s) {\n        report();\n    }" $process }}{{ else if $subs }}{{ $process = print $process ";" }}{{ else if $ends }}{{ $process = print $process "\n    report();" }}{{ end -}}
{{- /* a name used as both a guard and an action, in any table, is one method that returns bool and is not const */ -}}
{{- $calls := regexFindAll "const auto [A-Za-z0-9_]+ = \\[\\]\\((const )?[A-Za-z0-9_]+& actions\\) \\{ (return )?actions\\." $code -1 -}}
{{- $guards := list -}}{{- $effects := list -}}
{{- range $calls -}}
{{- $name := regexReplaceAll "^const auto ([A-Za-z0-9_]+) = .*$" . "$1" -}}
{{- if contains "{ return" . }}{{ $guards = append $guards $name }}{{ end -}}
{{- if not (contains "(const " .) }}{{ $effects = append $effects $name }}{{ end -}}
{{- end -}}
{{- $guards = uniq $guards | sortAlpha -}}{{- $effects = uniq $effects | sortAlpha -}}
{{- range $guards -}}
{{- if has . $effects -}}
{{- $both := printf "const auto %s = [](%s& actions) { return actions.%s(); };" . $actions . -}}
{{- $code = replace (printf "const auto %s = [](const %s& actions) { return actions.%s(); };" . $actions .) $both $code | replace (printf "const auto %s = [](%s& actions) { actions.%s(); };" . $actions .) $both -}}
{{- end -}}
{{- end -}}
{{- file (print $events ".h") }}
{{ $generated }}
#pragma once

// The events the state machine{{ surround " \"" .Name "\"" }} reacts to.
class {{ $events }} {
public:
    virtual ~{{ $events }}() = default;
{{- with include "eventIds" . }}
{{ range splitList "\n" . }}
    virtual void {{ . }}() = 0;
{{- end -}}
{{- end }}
};
{{ file (print $actions ".h") }}
{{ $generated }}
#pragma once

// The guards and actions the state machine{{ surround " \"" .Name "\"" }} calls.
// Implement them and pass the implementation to {{ $fsm }}'s constructor.
{{- with .Variables }}
//
// The machine's variables, which the implementation holds:
{{- range . }}
//   {{ .Name }}{{ prefix " = " .Value | include "oneLine" }}
{{- end -}}
{{- end }}
class {{ $actions }} {
public:
    virtual ~{{ $actions }}() = default;
{{- with $guards }}

    // Guards
{{- range . }}
    virtual bool {{ . }}(){{ if not (has . $effects) }} const{{ end }} = 0;
{{- end -}}
{{- end -}}
{{- $only := list -}}{{- range $effects }}{{ if not (has . $guards) }}{{ $only = append $only . }}{{ end }}{{ end -}}
{{- with $only }}

    // Actions
{{- range . }}
    virtual void {{ . }}() = 0;
{{- end -}}
{{- end }}
};
{{ file (print $fsm ".h") }}
{{ $generated }}
#pragma once

#include "{{ $actions }}.h"
#include "{{ $events }}.h"

#include <memory>
{{- with $machines }}
{{ range . }}
class {{ . }};
{{- end -}}
{{- end }}

// What the state machine{{ surround " \"" .Name "\"" }} tells when it ends, as a submachine does.
class {{ $listener }} {
public:
    virtual ~{{ $listener }}() = default;

    // It reached its final state.
    virtual void onFinished() {}
{{- range $exits }}
    // It left by its exit point "{{ . }}".
    virtual void onExit{{ include "pascal" . }}() {}
{{- end }}
};

// The state machine{{ surround " \"" .Name "\"" }}.
{{- with .Note }}
//
{{ include "comment" . | trimPrefix "\n" }}
{{- end }}
class {{ $fsm }} : public {{ $events }} {
public:
    // Where enterFsm starts the machine: its initial state{{ if $entries }} or an entry point{{ end }}.
    enum class Entry { initial{{ range $entries }}, {{ include "entryId" . }}{{ end }} };
{{ with $subs }}
    // The machines the submachine states run, one each:
{{- range . }}
    // {{ include "sid" .Name }} runs "{{ .Submachine }}" in the state "{{ .Name }}".
{{- end -}}
{{- end }}
    explicit {{ $fsm }}({{ $actions }}& actions{{ range $subs }}, {{ include "machineClass" .Submachine }}& {{ include "sid" .Name }}{{ end }});
    ~{{ $fsm }}() override;

    {{ $fsm }}(const {{ $fsm }}&) = delete;
    {{ $fsm }}& operator=(const {{ $fsm }}&) = delete;

    // Starts the machine, again if it runs, in its initial state{{ if $entries }} or at an entry point{{ end }}.
    void enterFsm(Entry entry = Entry::initial);
    // Stops the machine: it ignores every event until entered again.
    void stopFsm();
    // Tells listener when the machine ends; nullptr tells no one.
    void setListener({{ $listener }}* listener);
{{- with include "eventIds" . }}
{{ range splitList "\n" . }}
    void {{ . }}() override;
{{- end -}}
{{- end }}

private:
{{- if $ends }}
    void report();
{{ end }}
    struct Machine;
    {{ $actions }}& actions_;
{{- range $subs }}
    {{ include "machineClass" .Submachine }}& {{ include "sid" .Name }}_;
{{- end }}
    {{ $listener }}* listener_ = nullptr;
    std::unique_ptr<Machine> machine_;
};
{{ file (print $fsm ".cpp") }}
{{ $generated }}
#include "{{ $fsm }}.h"
{{- range $machines }}
#include "{{ . }}.h"
{{- end }}

#include <boost/sml.hpp>
{{- if or $defer $subs }}
#include <deque>
{{- end }}
{{- if $subs }}
#include <functional>
#include <utility>
{{- end }}

namespace {

namespace sml = boost::sml;
{{- with include "eventIds" . }}

namespace event {
{{- range splitList "\n" . }}
struct {{ . }} {};
{{- end }}
}  // namespace event
{{- end }}

// The events the machine sends itself, and the state it waits in until entered.
namespace internal {
{{- range $internal }}
struct {{ . }} {};
{{- end }}
}  // namespace internal
{{- with $subs }}

// The machines the submachine states run, and the entry point each starts at next.
struct submachines {
{{- range . }}
    {{ include "machineClass" .Submachine }}& {{ include "sid" .Name }};
    {{ include "machineClass" .Submachine }}::Entry {{ include "sid" .Name }}_entry = {{ include "machineClass" .Submachine }}::Entry::initial;
{{- end }}
};
{{- end }}
{{ $code | trimPrefix "\n" }}

}  // namespace

struct {{ $fsm }}::Machine {
{{- if $subs }}
{{- range $subs }}
{{- $sid := include "sid" .Name }}
    // Hands what the machine of "{{ .Name }}" reports to this one.
    struct {{ include "pascal" .Name }}Listener : {{ include "machineClass" .Submachine }}Listener {
        explicit {{ include "pascal" .Name }}Listener({{ $fsm }}& fsm) : fsm{fsm} {}
{{- if has (printf "%s_finished" $sid) $internal }}
        void onFinished() override {
            {{ include "adapterProcess" (dict "event" (printf "internal::%s_finished{}" $sid) "ends" $ends) }}
        }
{{- end -}}
{{- range Children .Name -}}
{{- if and (eq .Kind "exit-point") (has (printf "%s_exit_%s" $sid (include "cid" .Name)) $internal) }}
        void onExit{{ include "pascal" .Name }}() override {
            {{ include "adapterProcess" (dict "event" (printf "internal::%s_exit_%s{}" $sid (include "cid" .Name)) "ends" $ends) }}
        }
{{- end -}}
{{- end }}
        {{ $fsm }}& fsm;
    };
{{ end }}
    Machine({{ $fsm }}& fsm, {{ $actions }}& actions{{ range $subs }}, {{ include "machineClass" .Submachine }}& {{ include "sid" .Name }}{{ end }})
        : machines{ {{- range $i, $s := $subs }}{{ if $i }}, {{ end }}.{{ include "sid" $s.Name }} = {{ include "sid" $s.Name }}{{ end -}} },
{{- range $subs }}
          {{ include "sid" .Name }}_listener{fsm},
{{- end }}
          sm{actions, machines} {
{{- range $subs }}
        {{ include "sid" .Name }}.stopFsm();
        {{ include "sid" .Name }}.setListener(&{{ include "sid" .Name }}_listener);
{{- end }}
    }

    ~Machine() {
{{- range $subs }}
        machines.{{ include "sid" .Name }}.setListener(nullptr);
{{- end }}
    }

    // Processes an event, or queues it while processing another, since a
    // submachine may report while this machine enters it. Returns whether it
    // processed the event.
    template <class Event>
    bool process(const Event& event) {
        if (busy) {
            queue.push_back([this, event] { sm.process_event(event); });
            return false;
        }
        busy = true;
        sm.process_event(event);
        while (!queue.empty()) {
            auto next = std::move(queue.front());
            queue.pop_front();
            next();
        }
        busy = false;
        return true;
    }

    ::submachines machines;
{{- range $subs }}
    {{ include "pascal" .Name }}Listener {{ include "sid" .Name }}_listener;
{{- end }}
    sml::sm<machine{{ if $defer }}, sml::defer_queue<std::deque>{{ end }}> sm;
    bool busy = false;
    std::deque<std::function<void()>> queue;
{{- else }}
    explicit Machine({{ $actions }}& actions) : sm{actions} {}
    sml::sm<machine{{ if $defer }}, sml::defer_queue<std::deque>{{ end }}> sm;
{{- end }}
};

{{ $fsm }}::{{ $fsm }}({{ $actions }}& actions{{ range $subs }}, {{ include "machineClass" .Submachine }}& {{ include "sid" .Name }}{{ end }})
    : actions_{actions},
{{- range $subs }}
      {{ include "sid" .Name }}_{ {{- include "sid" .Name -}} },
{{- end }}
      machine_{std::make_unique<Machine>({{ if $subs }}*this, {{ end }}actions{{ range $subs }}, {{ include "sid" .Name }}{{ end }})} {}

{{ $fsm }}::~{{ $fsm }}() = default;

void {{ $fsm }}::enterFsm(Entry entry) {
    stopFsm();
    switch (entry) {
    case Entry::initial:
        {{ printf $process "internal::enter{}" | replace "\n" "\n    " }}
        break;
{{- range $entries }}
    case Entry::{{ include "entryId" . }}:
        {{ printf $process (printf "internal::enter_%s{}" (include "entryId" .)) | replace "\n" "\n    " }}
        break;
{{- end }}
    }
}

void {{ $fsm }}::stopFsm() {
    machine_->sm.process_event(internal::stop{});
    machine_.reset();
    machine_ = std::make_unique<Machine>({{ if $subs }}*this, {{ end }}actions_{{ range $subs }}, {{ include "sid" .Name }}_{{ end }});
}

void {{ $fsm }}::setListener({{ $listener }}* listener) {
    listener_ = listener;
}
{{- with $ends }}

void {{ $fsm }}::report() {
{{- $literal := false }}{{ range . }}{{ if ne (first .) "sml::X" }}{{ $literal = true }}{{ end }}{{ end }}
{{- if $literal }}
    using namespace sml::literals;
{{- end }}
    if (listener_ == nullptr) {
        return;
    }
{{- range $i, $end := . }}
    {{ if $i }}} else {{ end }}if (machine_->sm.is({{ first $end }})) {
        stopFsm();
        listener_->{{ last $end }}();
{{- end }}
    }
}
{{- end }}
{{- with include "eventIds" . }}
{{- if or $subs $ends }}
{{- range splitList "\n" . }}

void {{ $fsm }}::{{ . }}() {
    {{ printf $process (printf "event::%s{}" .) }}
}
{{- end -}}
{{- else }}
{{ range splitList "\n" . }}
void {{ $fsm }}::{{ . }}() { {{ printf $process (printf "event::%s{}" .) }} }
{{- end -}}
{{- end -}}
{{- end }}
{{ "" -}}

{{- define "structs" -}}{{- /* . = dict "scope" name "actions" interface: the structs of the composite states under scope, innermost first */ -}}
{{- $actions := .actions -}}
{{- range Children .scope -}}
{{- template "structs" (dict "scope" .Name "actions" $actions) -}}
{{- if IsRegion .Name -}}
{{- if or .OnEntry .OnExit .Do .Defer -}}
{{- warn "region %q: Boost.SML regions are anonymous; its behaviours and deferred events are not written" .Name -}}
{{- end -}}
{{- end -}}
{{- if HasTable .Name }}

// The {{ if .IsParallel }}orthogonal{{ else }}composite{{ end }} state "{{ .Name }}".
struct {{ include "sid" .Name }} {
    auto operator()() const {
{{ include "body" (dict "table" .Name "actions" $actions) | trimPrefix "\n" | indent 8 }}
    }
};
{{- end -}}
{{- end -}}
{{- end -}}

{{- define "body" -}}{{- /* . = dict "table" name ("" = the machine) "actions" interface: the body of operator() */ -}}
{{- $table := .table -}}
{{- $actions := .actions -}}
{{- $items := list -}}
{{- $pending := "" -}}
{{- range include "tableItems" $table | splitList "⟪row⟫" -}}
{{- if not . -}}
{{- else if include "isComment" . -}}
{{- $pending = print $pending . -}}
{{- else -}}
{{- $items = append $items (print $pending .) -}}
{{- $pending = "" -}}
{{- end -}}
{{- end -}}
{{- $rows := join "," $items -}}
{{- if $items }}{{ $rows = print $rows $pending }}{{ end -}}
{{- $guards := regexFindAll "⟨g:[A-Za-z0-9_]+⟩" $rows -1 | uniq -}}
{{- $effects := regexFindAll "⟨a:[A-Za-z0-9_]+⟩" $rows -1 | uniq -}}
{{- $lambdas := list -}}
{{- range concat $guards $effects }}{{ $lambdas = append $lambdas (regexReplaceAll "⟨.:(.*)⟩" . "$1") }}{{ end -}}
{{- $lambdas = uniq $lambdas -}}
{{- if has "event" $lambdas }}{{ $rows = replace "⟨e:" "⟨e:::event::" $rows }}{{ else }}{{ $rows = replace "⟨e:" "⟨e:event::" $rows }}{{ end -}}
{{- range $lambdas }}{{ $rows = replace (printf "⟨s:%s⟩" .) (printf "::%s" .) $rows }}{{ end }}
using namespace sml::literals;
{{- if regexMatch "&&|\\|\\||!|/ \\(" $rows }}
using sml::operator!, sml::operator&&, sml::operator||, sml::operator,;
{{- end -}}
{{- range $lambdas -}}
{{- $guard := has (printf "⟨g:%s⟩" .) $guards -}}
{{- $effect := has (printf "⟨a:%s⟩" .) $effects }}
const auto {{ . }} = [](
{{- if and $guard $effect }}{{ $actions }}& actions) { return actions.{{ . }}(); };
{{- else if $guard }}const {{ $actions }}& actions) { return actions.{{ . }}(); };
{{- else }}{{ $actions }}& actions) { actions.{{ . }}(); };
{{- end -}}
{{- end }}
return sml::make_transition_table(
{{ regexReplaceAll "⟨.:([^⟩]*)⟩" $rows "$1" | trimPrefix "\n" | indent 4 }}
);
{{- end -}}

{{- define "isComment" -}}{{- /* . = table item: non-empty when every line of it is a comment */ -}}
{{- if not (regexMatch "(?m)^[ \t]*[^/ \t\n]" .) }}comment{{ end -}}
{{- end -}}

{{- define "tableItems" -}}{{- /* . = table name: its rows, each preceded by its comments, separated by ⟪row⟫ */ -}}
{{- $table := . -}}
{{- $out := list -}}
{{- $initials := Initials $table -}}
{{- if eq $table "" -}}
{{- /* the machine waits in internal::stopped until enterFsm */ -}}
{{- $enter := "\n*sml::state<::internal::stopped> + sml::event<::internal::enter>" -}}
{{- range $initials -}}
{{- $enter = printf "%s%s = %s" $enter (include "actions" (dict "list" (InitialActionsOf "") "what" "the machine's initial transition")) (include "ref" .State) -}}
{{- else -}}
{{- $enter = print $enter " / [] {}" -}}
{{- end -}}
{{- $out = append $out $enter -}}
{{- $initials = list -}}
{{- end -}}
{{- range $initials -}}
{{- $scope := .Scope -}}
{{- $init := .State -}}
{{- with InitialActionsOf $scope -}}
{{- $from := include "str" (ternary "initial" (printf "%s.initial" $scope) (eq $scope "")) -}}
{{- $mark := ternary (printf "%s(sml::H)" $from) (printf "*%s" $from) (not (not (HistoryOf $scope))) -}}
{{- $what := ternary "the machine's initial transition" (printf "the initial transition of %q" $scope) (eq $scope "") -}}
{{- $out = append $out (printf "\n%s%s = %s" $mark (include "actions" (dict "list" . "what" $what)) (include "ref" $init)) -}}
{{- end -}}
{{- end -}}
{{- range States -}}
{{- if and (not (IsRegion .Name)) (eq (TableOf .Name) $table) -}}
{{- $out = append $out (include "memberItems" (dict "state" . "initials" $initials)) -}}
{{- end -}}
{{- end -}}
{{- if eq $table "" -}}
{{- /* stopFsm leaves whatever state the machine is in, running its exit behaviours */ -}}
{{- range Children "" -}}
{{- if or .IsNormal .IsParallel -}}
{{- $out = append $out (printf "\n%s + sml::event<::internal::stop> = sml::state<::internal::stopped>" (include "ref" .Name)) -}}
{{- end -}}
{{- end -}}
{{- end -}}
{{- join "⟪row⟫" $out -}}
{{- end -}}

{{- define "memberItems" -}}{{- /* . = dict "state" *State "initials" its table's Initials: the state's comments and rows in its table */ -}}
{{- $s := .state -}}
{{- $src := include "ref" $s.Name -}}
{{- $first := $src -}}
{{- range .initials -}}
{{- if and (eq .State $s.Name) (not (InitialActionsOf .Scope)) -}}
{{- $first = ternary (printf "%s(sml::H)" $src) (printf "*%s" $src) (not (not (HistoryOf .Scope))) -}}
{{- end -}}
{{- end -}}
{{- $items := list -}}
{{- $comments := include "stateComments" $s -}}
{{- $rows := include "stateRows" $s | splitList "⟪row⟫" -}}
{{- range $rows -}}
{{- if . -}}
{{- $row := . -}}
{{- if not (contains "\n⟨src⟩" $row) -}}
{{- $items = append $items (regexReplaceAll "⟨.:([^⟩]*)⟩" (replace "⟨src⟩" $src $row) "$1") -}}
{{- else -}}
{{- $items = append $items (replace "⟨src⟩" (ternary (printf "(%s)" $first) $first (and (hasPrefix "*" $first) (contains "\n⟨src⟩ [" $row))) $row) -}}
{{- $first = $src -}}
{{- end -}}
{{- end -}}
{{- end -}}
{{- if ne $first $src -}}
{{- /* an initial state no row mentions as its source: SML needs a row to mark it */ -}}
{{- $items = append $items (printf "\n%s + sml::on_entry<sml::_> / [] {}" $first) -}}
{{- end -}}
{{- if $items -}}
{{- $items = prepend (rest $items) (print $comments (first $items)) -}}
{{- else -}}
{{- $items = list $comments -}}
{{- end -}}
{{- join "⟪row⟫" $items -}}
{{- end -}}

{{- define "stateComments" -}}{{- /* . = *State: its stereotype, note, invariant and variables as comments before its rows */ -}}
{{- $lines := list -}}
{{- with .Stereotype }}{{ $lines = append $lines (printf "«%s»" .) }}{{ end -}}
{{- with .Note }}{{ $lines = append $lines . }}{{ end -}}
{{- with .Invariant }}{{ $lines = append $lines (printf "invariant: %s" .) }}{{ end -}}
{{- with .InvariantNote }}{{ $lines = append $lines . }}{{ end -}}
{{- range .Variables }}{{ $lines = append $lines (printf "variable: %s%s" .Name (prefix " = " .Value)) }}{{ end -}}
{{- if $lines -}}
{{- $lines = prepend $lines (printf "%s:" .Name) -}}
{{- include "comment" (join "\n" $lines) -}}
{{- end -}}
{{- end -}}

{{- define "stateRows" -}}{{- /* . = *State: its behaviours and the transitions leaving it, sources written ⟨src⟩, separated by ⟪row⟫ */ -}}
{{- $s := . -}}
{{- $out := list -}}
{{- $start := list -}}{{- $stop := list -}}
{{- if $s.Submachine -}}
{{- /* a submachine state enters its machine after its entry behaviour, and stops it before its exit behaviour */ -}}
{{- $sid := include "sid" $s.Name -}}
{{- $start = list (printf "[](::submachines& s) { s.%s.enterFsm(std::exchange(s.%s_entry, %s::Entry::initial)); }" $sid $sid (include "machineClass" $s.Submachine)) -}}
{{- $stop = list (printf "[](::submachines& s) { s.%s.stopFsm(); }" $sid) -}}
{{- end -}}
{{- if and $s.IsPseudo (or $s.OnEntry $s.OnExit) -}}
{{- warn "state %q: Boost.SML's final state X has no entry or exit behaviour; it is not written" $s.Name -}}
{{- else -}}
{{- if or $s.OnEntry $start }}{{ $out = append $out (printf "%s\n⟨src⟩ + sml::on_entry<sml::_>%s" (include "comment" $s.EntryNote) (include "actions" (dict "list" $s.OnEntry "after" $start "what" (printf "the entry behaviour of %q" $s.Name)))) }}{{ end -}}
{{- if or $s.OnExit $stop }}{{ $out = append $out (printf "%s\n⟨src⟩ + sml::on_exit<sml::_>%s" (include "comment" $s.ExitNote) (include "actions" (dict "list" $s.OnExit "before" $stop "what" (printf "the exit behaviour of %q" $s.Name)))) }}{{ end -}}
{{- end -}}
{{- with $s.Do -}}
{{- warn "state %q: Boost.SML has no do activities; %s is written as a comment" $s.Name (join ", " .) -}}
{{- $out = append $out (include "comment" (joinNonEmpty "\n" (printf "do / %s" (join ", " .)) $s.DoNote)) -}}
{{- end -}}
{{- range $s.Defer -}}
{{- $out = append $out (printf "%s\n⟨src⟩ + sml::event<⟨e:%s⟩> / sml::defer" (include "comment" (index $s.DeferNotes .)) (include "cid" .)) -}}
{{- end -}}
{{- include "pseudoWarnings" $s -}}
{{- /* transitions whose lifted source is this state, an else branch after its siblings */ -}}
{{- $else := list -}}
{{- range $t := Transitions -}}
{{- with $lift := Lift $t -}}
{{- $src := $lift.Source -}}
{{- $effSrc := $lift.From -}}
{{- $completion := not (or $t.Event $t.After) -}}
{{- $row := "" -}}
{{- if and (eq $src $s.Name) (ne $src $effSrc) $completion -}}
{{- /* a completion transition from inside: the inside ends (X), which completes this state */ -}}
{{- if eq (TableOf $effSrc) $src -}}
{{- $row = include "row" (dict "t" $t "lift" $lift "mode" "outer") -}}
{{- else -}}
{{- warn "transition %s -> %s: Boost.SML has no transitions from inside a composite state, and %q lies too deep inside %q to complete it; it is not written" $t.Source (join " " $t.Targets) $t.Source $src -}}
{{- end -}}
{{- else if eq $src $s.Name -}}
{{- $row = include "row" (dict "t" $t "lift" $lift "mode" "") -}}
{{- else if and (eq $effSrc $s.Name) $completion (eq (TableOf $effSrc) $src) -}}
{{- $row = include "row" (dict "t" $t "lift" $lift "mode" "inner") -}}
{{- end -}}
{{- if not $row -}}
{{- else if eq $t.Cond "else" }}{{ $else = append $else $row }}{{ else }}{{ $out = append $out $row }}{{ end -}}
{{- end -}}
{{- end -}}
{{- join "⟪row⟫" (concat $out $else) -}}
{{- end -}}

{{- define "pseudoWarnings" -}}{{- /* . = *State: the kinds SML has no counterpart for */ -}}
{{- $s := . -}}
{{- if .IsTerminate -}}
{{- warn "state %q: Boost.SML has no terminate; written as X, which ends only its own region" .Name -}}
{{- else if eq .Kind "history-deep" -}}
{{- warn "state %q: Boost.SML has only shallow history; written as a shallow one" .Name -}}
{{- else if eq .Kind "fork" -}}
{{- warn "state %q: Boost.SML has no fork; transitions to it enter %q, whose regions start in their initial states, and its own transitions are not written" .Name (ForkTarget .Name) -}}
{{- else if eq .Kind "join" -}}
{{- with JoinOwner .Name -}}
{{- warn "state %q: Boost.SML has no join; transitions to it end their region (X), and its outgoing transition is taken once every region of %q has ended" $s.Name . -}}
{{- else -}}
{{- warn "state %q: Boost.SML has no join, and its incoming transitions do not all come from one orthogonal state; the transitions to and from it are not written" $s.Name -}}
{{- end -}}
{{- else if and (eq .Kind "entry-point") .Parent (not (IsReference .Name)) -}}
{{- warn "state %q: Boost.SML has no entry points; transitions to it enter %q at its initial state, and its own transitions are not written" .Name .Parent -}}
{{- else if eq .Kind "entry-point" -}}
{{- if and (not .Parent) (IncomingTransitions .Name) -}}
{{- warn "state %q: the machine is entered at its entry point by enterFsm; the transitions to it are not written" .Name -}}
{{- end -}}
{{- else if and (eq .Kind "exit-point") .Parent (not (IsReference .Name)) -}}
{{- warn "state %q: Boost.SML has no exit points; the transitions to and from it are not written" .Name -}}
{{- else if eq .Kind "exit-point" -}}
{{- if and (not .Parent) (OutgoingTransitions .Name) -}}
{{- warn "state %q: the machine ends at its exit point; the transitions from it are not written" .Name -}}
{{- end -}}
{{- end -}}
{{- if .IsHistory -}}
{{- range OutgoingTransitions .Name -}}
{{- $scope := State $s.Parent -}}
{{- if or (ne (join " " .Targets) (default "" $scope.Initial)) .Actions -}}
{{- warn "state %q: Boost.SML resumes a history in its region's initial state the first time; the default transition to %s is not written" $s.Name (join " " .Targets) -}}
{{- end -}}
{{- end -}}
{{- end -}}
{{- end -}}

{{- define "row" -}}{{- /* . = dict "t" *Transition "lift" its Lift "mode" "", or "inner" and "outer" for the two rows of a completion transition from inside a composite state: the row, source written ⟨src⟩ */ -}}
{{- $t := .t -}}
{{- $mode := .mode -}}
{{- $src := .lift.Source -}}
{{- $tgt := .lift.Target -}}
{{- $effSrc := .lift.From -}}
{{- $effTgt := .lift.To -}}
{{- $label := printf "transition %s -> %s" $t.Source (join " " $t.Targets) -}}
{{- if ne $mode "inner" -}}
{{- if gt (len $t.Targets) 1 -}}
{{- warn "%s: a Boost.SML transition has one target; only %s is written" $label (first $t.Targets) -}}
{{- end -}}
{{- if eq $mode "outer" -}}
{{- warn "%s: Boost.SML has no transitions from inside a composite state; written as %q going to X, which completes %q, and a completion transition of %q" $label $effSrc $src $src -}}
{{- else if ne $src $effSrc -}}
{{- warn "%s: Boost.SML has no transitions from inside a composite state; written as a transition of %q" $label $src -}}
{{- end -}}
{{- if and $tgt (ne $tgt $effTgt) -}}
{{- warn "%s: Boost.SML has no transitions into a composite state; it enters %q at its initial state" $label $tgt -}}
{{- else if and $tgt (HistoryOf $tgt) (eq (first $t.Targets) $tgt) -}}
{{- warn "%s: %q has a history, so Boost.SML resumes it here too" $label $tgt -}}
{{- end -}}
{{- if $t.IsLocal -}}
{{- warn "%s: Boost.SML has no local transitions; written as an external one" $label -}}
{{- end -}}
{{- end -}}
{{- $from := State $t.Source -}}
{{- $to := dict -}}{{- with $t.Targets }}{{ $to = State (first .) }}{{ end -}}
{{- $enterBy := list -}}
{{- if and (eq (default "" $to.Kind) "entry-point") (IsReference $to.Name) -}}
{{- $enterBy = list (printf "[](::submachines& s) { s.%s_entry = %s::Entry::%s; }" (include "sid" $to.Parent) (include "machineClass" (State $to.Parent).Submachine) (include "entryId" $to.Name)) -}}
{{- end -}}
{{- $trigger := "" -}}
{{- if and (eq $from.Kind "entry-point") (not $from.Parent) -}}
{{- $trigger = printf " + sml::event<::internal::enter_%s>" (include "entryId" $from.Name) -}}
{{- else if eq $from.Kind "exit-point" -}}
{{- $trigger = printf " + sml::event<::internal::%s_exit_%s>" (include "sid" $from.Parent) (include "cid" $from.Name) -}}
{{- else if and $from.Submachine (not $t.Event) (not $t.After) -}}
{{- $trigger = printf " + sml::event<::internal::%s_finished>" (include "sid" $from.Name) -}}
{{- else if $t.After -}}
{{- $trigger = printf " + sml::event<⟨e:%s⟩>" (include "afterEvent" $t.After) -}}
{{- warn "%s: Boost.SML has no time triggers; written on the event %s, which the application raises %s after entering %s" $label (include "afterEvent" $t.After) $t.After $t.Source -}}
{{- else if $t.Event -}}
{{- $trigger = printf " + sml::event<⟨e:%s⟩>" (include "cid" $t.Event) -}}
{{- end -}}
{{- $guard := "" -}}
{{- $bad := false -}}
{{- if and $t.Cond (ne $t.Cond "else") (ne $mode "outer") -}}
{{- if regexMatch "^[A-Za-z0-9_()! \t\n]*$" $t.Cond -}}
{{- $guard = regexReplaceAll "[A-Za-z_][A-Za-z0-9_]*" $t.Cond "⟨g:$0⟩" | replace "⟨g:and⟩" "&&" | replace "⟨g:or⟩" "||" -}}
{{- $guard = printf " [%s]" (regexReplaceAll "⟨g:not⟩\\s*" $guard "!") -}}
{{- else -}}
{{- $bad = true -}}
{{- $guard = printf " [%s]" $t.Cond -}}
{{- warn "%s: the guard [%s] is not made of names; the transition is written as a comment" $label $t.Cond -}}
{{- end -}}
{{- end -}}
{{- $row := "" -}}
{{- if eq $mode "inner" -}}
{{- $row = printf "⟨src⟩%s = sml::X" $guard -}}
{{- else -}}
{{- $row = printf "⟨src⟩%s%s%s" $trigger $guard (include "actions" (dict "list" $t.Actions "after" $enterBy "what" $label)) -}}
{{- if $tgt }}{{ $row = printf "%s = %s" $row (include "ref" $tgt) }}{{ else if not $t.Actions }}{{ $row = print $row " / [] {}" }}{{ end -}}
{{- include "comment" $t.Note -}}
{{- end -}}
{{- if $bad }}
// {{ $row }}
{{- else }}
{{ $row }}
{{- end -}}
{{- end -}}

{{- define "actions" -}}{{- /* . = dict "list" actions "what" whose, and "before" and "after" lambdas to run around them: " / a" or " / (a, b)", names only */ -}}
{{- $names := default list .before -}}
{{- $what := .what -}}
{{- range .list -}}
{{- if regexMatch "^[A-Za-z_][A-Za-z0-9_]*$" . -}}
{{- $names = append $names (printf "⟨a:%s⟩" .) -}}
{{- else -}}
{{- warn "%s: the action %q is not a name; it is not written" $what . -}}
{{- end -}}
{{- end -}}
{{- $names = concat $names (default list .after) -}}
{{- if eq (len $names) 1 }} / {{ first $names }}
{{- else if $names }} / ({{ join ", " $names }})
{{- else if .list }} / [] {}
{{- end -}}
{{- end -}}

{{- define "ref" -}}{{- /* . = state name: the state as SML writes it, a join as the end of its region */ -}}
{{- $s := State . -}}
{{- if and (eq $s.Kind "entry-point") (not $s.Parent) }}sml::state<::internal::stopped>
{{- else if or $s.IsFinal $s.IsTerminate (eq $s.Kind "join") }}sml::X
{{- else if HasTable . }}sml::state<⟨s:{{ include "sid" . }}⟩>
{{- else }}{{ include "str" . }}
{{- end -}}
{{- end -}}

{{- define "sid" -}}{{- /* . = state name: its struct's name, kept apart from the names the file defines */ -}}
{{- $id := include "cid" . -}}
{{- if has $id (list "machine" "sml" "event" "internal" "submachines" "actions") }}{{ $id }}_state{{ else }}{{ $id }}{{ end -}}
{{- end -}}

{{- define "eventIds" -}}{{- /* . = anything: every event's struct name, one per line, in order of first use */ -}}
{{- $ids := list -}}
{{- range States }}{{ range .Defer }}{{ $ids = append $ids (include "cid" .) }}{{ end }}{{ end -}}
{{- range Transitions -}}
{{- if .After }}{{ $ids = append $ids (include "afterEvent" .After) }}{{ else if .Event }}{{ $ids = append $ids (include "cid" .Event) }}{{ end -}}
{{- end -}}
{{- join "\n" (uniq $ids) -}}
{{- end -}}

{{- define "pascal" -}}{{- /* . = machine name: its words run together, each capitalised, "Machine" when it has none */ -}}
{{- $words := list -}}
{{- range regexSplit "[^A-Za-z0-9]+" (default "" .) -1 }}{{ if . }}{{ $words = append $words (print (upper (substr 0 1 .)) (substr 1 -1 .)) }}{{ end }}{{ end -}}
{{- $name := default "Machine" (join "" $words) -}}
{{- if regexMatch "^[0-9]" $name }}_{{ end }}{{ $name -}}
{{- end -}}

{{- define "machineClass" -}}{{- /* . = a submachine state's Submachine: the class of the machine it names, its file's name without extension */ -}}
{{- $base := base . -}}
{{- include "pascal" (trimSuffix (ext $base) $base) }}Fsm
{{- end -}}

{{- define "entryId" -}}{{- /* . = an entry point's name: its Entry value, kept apart from initial */ -}}
{{- $id := include "cid" . -}}
{{- if eq $id "initial" }}initial_point{{ else }}{{ $id }}{{ end -}}
{{- end -}}

{{- define "adapterProcess" -}}{{- /* . = dict "event" an internal event "ends" whether the machine reports: a submachine listener's body */ -}}
{{- if .ends -}}
if (fsm.machine_->process({{ .event }})) {
                fsm.report();
            }
{{- else -}}
fsm.machine_->process({{ .event }});
{{- end -}}
{{- end -}}

{{- define "afterEvent" -}}{{- /* . = delay: the event a time trigger waits for */ -}}
{{- print "after_" . | include "cid" -}}
{{- end -}}

{{- define "cid" -}}{{- /* . = name, as a C++ identifier */ -}}
{{- $id := regexReplaceAll "[^A-Za-z0-9_]" . "_" -}}
{{- if regexMatch "^[0-9]" $id }}_{{ end }}{{ $id -}}
{{- end -}}

{{- define "str" -}}{{- /* . = state name, as an SML string-literal state */ -}}
"{{ replace "\\" "\\\\" . | replace "\"" "\\\"" }}"_s
{{- end -}}

{{- define "comment" -}}{{- /* . = text: one // line per line, each starting with a newline; nothing when empty */ -}}
{{- if . -}}
{{- range splitList "\n" . }}
//{{ prefix " " . }}
{{- end -}}
{{- end -}}
{{- end -}}

{{- define "oneLine" -}}{{- /* . = text: line breaks become spaces */ -}}
{{- replace "\n" " " . -}}
{{- end -}}
