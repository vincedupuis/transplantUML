{{- /*
Boost.SML state machine (https://github.com/boost-ext/sml), as four C++20
files named after the machine, here "kiosk":

  KioskFsmEvents.h   the interface declaring one method per event
  KioskFsmActions.h  the interface declaring the guards and actions, which the
                     user of the state machine implements
  KioskFsm.h         the state machine: a class implementing KioskFsmEvents,
                     built from a KioskFsmActions
  KioskFsm.cpp       its implementation, the only file that includes SML

"." at the top level is the *model.StateMachine. Each file starts with a call
to file, and every emitted line starts with a newline, as in puml.gotmpl.

In KioskFsm.cpp the SML code lives in an anonymous namespace: the events are
empty structs in namespace event, each compound or orthogonal state is a
struct of its own, declared before the struct that uses it, and the machine's
own table is struct machine. SML hands every guard and action the
KioskFsmActions the state machine was built from, so a guard [inStock]
becomes a lambda calling actions.inStock() and an action / addLine one calling
actions.addLine(). Simple states and pseudostates are string-literal states
("idle"_s), final states SML's X.

A transition table holds the states of one scope, with a parallel state's
regions flattened into its own table, one initial state (*) per region. A
transition is written in the innermost table holding both its ends, after
lifting them out of the scopes it crosses: SML has no transitions into or out
of a composite state's inside, so those leave from, or enter, that composite
state as a whole, with a warning.

Rows are built first and the lambdas declared after, from what the rows use:
a row marks each guard ⟨g:name⟩, action ⟨a:name⟩, event ⟨e:name⟩ and struct
⟨s:name⟩. A lambda would hide the event namespace or a struct of the same
name, so those are then written fully qualified. Rows are joined by ⟪row⟫, and
a comment that precedes no row is carried to the next one, since the table
cannot end on a comma. The interfaces are written last in the template, from
the lambdas the tables declared, but first in the output.
*/ -}}
{{- $fsm := print (include "pascal" .Name) "Fsm" -}}
{{- $events := print $fsm "Events" -}}
{{- $actions := print $fsm "Actions" -}}
{{- $defer := false -}}{{- range States }}{{ if .Defer }}{{ $defer = true }}{{ end }}{{ end -}}
{{- $generated := printf "// Generated by fsm%s. Do not edit." (surround " from the state machine \"" .Name "\"") -}}
{{- $code := include "structs" (dict "scope" "" "actions" $actions) -}}
{{- $code = printf "%s\n\nstruct machine {\n    auto operator()() const {\n%s\n    }\n};" $code (include "body" (dict "table" "" "actions" $actions) | trimPrefix "\n" | indent 8) -}}
{{- /* a name used as both a guard and an action, in any table, is one method that returns bool and is not const */ -}}
{{- $calls := regexFindAll "const auto [A-Za-z0-9_]+ = \\[\\]\\((const )?[A-Za-z0-9_]+& actions\\) \\{ (return )?actions\\." $code -1 -}}
{{- $guards := list -}}{{- $effects := list -}}
{{- range $calls -}}
{{- $name := regexReplaceAll "^const auto ([A-Za-z0-9_]+) = .*$" . "$1" -}}
{{- if contains "{ return" . }}{{ $guards = append $guards $name }}{{ end -}}
{{- if not (contains "(const " .) }}{{ $effects = append $effects $name }}{{ end -}}
{{- end -}}
{{- $guards = uniq $guards | sortAlpha -}}{{- $effects = uniq $effects | sortAlpha -}}
{{- range $guards -}}
{{- if has . $effects -}}
{{- $both := printf "const auto %s = [](%s& actions) { return actions.%s(); };" . $actions . -}}
{{- $code = replace (printf "const auto %s = [](const %s& actions) { return actions.%s(); };" . $actions .) $both $code | replace (printf "const auto %s = [](%s& actions) { actions.%s(); };" . $actions .) $both -}}
{{- end -}}
{{- end -}}
{{- file (print $events ".h") }}
{{ $generated }}
#pragma once

// The events the state machine{{ surround " \"" .Name "\"" }} reacts to.
class {{ $events }} {
public:
    virtual ~{{ $events }}() = default;
{{- with include "eventIds" . }}
{{ range splitList "\n" . }}
    virtual void {{ . }}() = 0;
{{- end -}}
{{- end }}
};
{{ file (print $actions ".h") }}
{{ $generated }}
#pragma once

// The guards and actions the state machine{{ surround " \"" .Name "\"" }} calls.
// Implement them and pass the implementation to {{ $fsm }}'s constructor.
{{- with .Variables }}
//
// The machine's variables, which the implementation holds:
{{- range . }}
//   {{ .Name }}{{ prefix " = " .Value | include "oneLine" }}
{{- end -}}
{{- end }}
class {{ $actions }} {
public:
    virtual ~{{ $actions }}() = default;
{{- with $guards }}

    // Guards
{{- range . }}
    virtual bool {{ . }}(){{ if not (has . $effects) }} const{{ end }} = 0;
{{- end -}}
{{- end -}}
{{- $only := list -}}{{- range $effects }}{{ if not (has . $guards) }}{{ $only = append $only . }}{{ end }}{{ end -}}
{{- with $only }}

    // Actions
{{- range . }}
    virtual void {{ . }}() = 0;
{{- end -}}
{{- end }}
};
{{ file (print $fsm ".h") }}
{{ $generated }}
#pragma once

#include "{{ $actions }}.h"
#include "{{ $events }}.h"

#include <memory>

// The state machine{{ surround " \"" .Name "\"" }}.
{{- with .Note }}
//
{{ include "comment" . | trimPrefix "\n" }}
{{- end }}
class {{ $fsm }} : public {{ $events }} {
public:
    explicit {{ $fsm }}({{ $actions }}& actions);
    ~{{ $fsm }}() override;

    {{ $fsm }}(const {{ $fsm }}&) = delete;
    {{ $fsm }}& operator=(const {{ $fsm }}&) = delete;
{{- with include "eventIds" . }}
{{ range splitList "\n" . }}
    void {{ . }}() override;
{{- end -}}
{{- end }}

private:
    struct Machine;
    std::unique_ptr<Machine> machine_;
};
{{ file (print $fsm ".cpp") }}
{{ $generated }}
#include "{{ $fsm }}.h"

#include <boost/sml.hpp>
{{- if $defer }}
#include <deque>
{{- end }}

namespace {

namespace sml = boost::sml;
{{- with include "eventIds" . }}

namespace event {
{{- range splitList "\n" . }}
struct {{ . }} {};
{{- end }}
}  // namespace event
{{- end }}
{{ $code | trimPrefix "\n" }}

}  // namespace

struct {{ $fsm }}::Machine {
    explicit Machine({{ $actions }}& actions) : sm{actions} {}
    sml::sm<machine{{ if $defer }}, sml::defer_queue<std::deque>{{ end }}> sm;
};

{{ $fsm }}::{{ $fsm }}({{ $actions }}& actions) : machine_{std::make_unique<Machine>(actions)} {}

{{ $fsm }}::~{{ $fsm }}() = default;
{{- with include "eventIds" . }}
{{ range splitList "\n" . }}
void {{ $fsm }}::{{ . }}() { machine_->sm.process_event(event::{{ . }}{}); }
{{- end -}}
{{- end }}
{{ "" -}}

{{- define "structs" -}}{{- /* . = dict "scope" name "actions" interface: the structs of the composite states under scope, innermost first */ -}}
{{- $actions := .actions -}}
{{- range Children .scope -}}
{{- template "structs" (dict "scope" .Name "actions" $actions) -}}
{{- if include "isRegion" .Name -}}
{{- if or .OnEntry .OnExit .Do .Defer -}}
{{- warn "region %q: Boost.SML regions are anonymous; its behaviours and deferred events are not written" .Name -}}
{{- end -}}
{{- end -}}
{{- if include "isStruct" .Name }}

// The {{ if .IsParallel }}orthogonal{{ else }}composite{{ end }} state "{{ .Name }}".
struct {{ include "sid" .Name }} {
    auto operator()() const {
{{ include "body" (dict "table" .Name "actions" $actions) | trimPrefix "\n" | indent 8 }}
    }
};
{{- end -}}
{{- end -}}
{{- end -}}

{{- define "body" -}}{{- /* . = dict "table" name ("" = the machine) "actions" interface: the body of operator() */ -}}
{{- $table := .table -}}
{{- $actions := .actions -}}
{{- $items := list -}}
{{- $pending := "" -}}
{{- range include "tableItems" $table | splitList "⟪row⟫" -}}
{{- if not . -}}
{{- else if include "isComment" . -}}
{{- $pending = print $pending . -}}
{{- else -}}
{{- $items = append $items (print $pending .) -}}
{{- $pending = "" -}}
{{- end -}}
{{- end -}}
{{- $rows := join "," $items -}}
{{- if $items }}{{ $rows = print $rows $pending }}{{ end -}}
{{- $guards := regexFindAll "⟨g:[A-Za-z0-9_]+⟩" $rows -1 | uniq -}}
{{- $effects := regexFindAll "⟨a:[A-Za-z0-9_]+⟩" $rows -1 | uniq -}}
{{- $lambdas := list -}}
{{- range concat $guards $effects }}{{ $lambdas = append $lambdas (regexReplaceAll "⟨.:(.*)⟩" . "$1") }}{{ end -}}
{{- $lambdas = uniq $lambdas -}}
{{- if has "event" $lambdas }}{{ $rows = replace "⟨e:" "⟨e:::event::" $rows }}{{ else }}{{ $rows = replace "⟨e:" "⟨e:event::" $rows }}{{ end -}}
{{- range $lambdas }}{{ $rows = replace (printf "⟨s:%s⟩" .) (printf "::%s" .) $rows }}{{ end }}
using namespace sml::literals;
{{- if regexMatch "&&|\\|\\||!|/ \\(" $rows }}
using sml::operator!, sml::operator&&, sml::operator||, sml::operator,;
{{- end -}}
{{- range $lambdas -}}
{{- $guard := has (printf "⟨g:%s⟩" .) $guards -}}
{{- $effect := has (printf "⟨a:%s⟩" .) $effects }}
const auto {{ . }} = [](
{{- if and $guard $effect }}{{ $actions }}& actions) { return actions.{{ . }}(); };
{{- else if $guard }}const {{ $actions }}& actions) { return actions.{{ . }}(); };
{{- else }}{{ $actions }}& actions) { actions.{{ . }}(); };
{{- end -}}
{{- end }}
return sml::make_transition_table(
{{ regexReplaceAll "⟨.:([^⟩]*)⟩" $rows "$1" | trimPrefix "\n" | indent 4 }}
);
{{- end -}}

{{- define "isComment" -}}{{- /* . = table item: non-empty when every line of it is a comment */ -}}
{{- if not (regexMatch "(?m)^[ \t]*[^/ \t\n]" .) }}comment{{ end -}}
{{- end -}}

{{- define "tableItems" -}}{{- /* . = table name: its rows, each preceded by its comments, separated by ⟪row⟫ */ -}}
{{- $table := . -}}
{{- $out := list -}}
{{- $initials := include "initials" $table | splitList "\n" -}}
{{- range $initials -}}
{{- $scope := . | splitList "\t" | last -}}
{{- $init := . | splitList "\t" | first -}}
{{- with InitialActionsOf $scope -}}
{{- $from := include "str" (ternary "initial" (printf "%s.initial" $scope) (eq $scope "")) -}}
{{- $mark := ternary (printf "%s(sml::H)" $from) (printf "*%s" $from) (not (not (HistoryOf $scope))) -}}
{{- $what := ternary "the machine's initial transition" (printf "the initial transition of %q" $scope) (eq $scope "") -}}
{{- $out = append $out (printf "\n%s%s = %s" $mark (include "actions" (dict "list" . "what" $what)) (include "ref" $init)) -}}
{{- end -}}
{{- end -}}
{{- range States -}}
{{- if and (not (include "isRegion" .Name)) (eq (include "tableOf" .Name) $table) -}}
{{- $out = append $out (include "memberItems" (dict "state" . "initials" $initials)) -}}
{{- end -}}
{{- end -}}
{{- join "⟪row⟫" $out -}}
{{- end -}}

{{- define "initials" -}}{{- /* . = table name: lines "initial state<TAB>scope it starts" */ -}}
{{- $table := . -}}
{{- $lines := list -}}
{{- $s := State $table -}}
{{- if and $s $s.IsParallel -}}
{{- range $r := Children $table -}}
{{- if include "isRegion" $r.Name -}}
{{- with $r.Initial }}{{ $lines = append $lines (printf "%s\t%s" . $r.Name) }}{{ end -}}
{{- else -}}
{{- $lines = append $lines (printf "%s\t%s" $r.Name $table) -}}
{{- end -}}
{{- end -}}
{{- else -}}
{{- with InitialOf $table }}{{ $lines = append $lines (printf "%s\t%s" . $table) }}{{ end -}}
{{- end -}}
{{- join "\n" $lines -}}
{{- end -}}

{{- define "memberItems" -}}{{- /* . = dict "state" *State "initials" lines: the state's comments and rows in its table */ -}}
{{- $s := .state -}}
{{- $src := include "ref" $s.Name -}}
{{- $first := $src -}}
{{- range .initials -}}
{{- $parts := splitList "\t" . -}}
{{- if and (eq (first $parts) $s.Name) (not (InitialActionsOf (last $parts))) -}}
{{- $first = ternary (printf "%s(sml::H)" $src) (printf "*%s" $src) (not (not (HistoryOf (last $parts)))) -}}
{{- end -}}
{{- end -}}
{{- $items := list -}}
{{- $comments := include "stateComments" $s -}}
{{- $rows := include "stateRows" $s | splitList "⟪row⟫" -}}
{{- range $rows -}}
{{- if . -}}
{{- $row := . -}}
{{- if not (contains "\n⟨src⟩" $row) -}}
{{- $items = append $items (regexReplaceAll "⟨.:([^⟩]*)⟩" (replace "⟨src⟩" $src $row) "$1") -}}
{{- else -}}
{{- $items = append $items (replace "⟨src⟩" (ternary (printf "(%s)" $first) $first (and (hasPrefix "*" $first) (contains "\n⟨src⟩ [" $row))) $row) -}}
{{- $first = $src -}}
{{- end -}}
{{- end -}}
{{- end -}}
{{- if ne $first $src -}}
{{- /* an initial state no row mentions as its source: SML needs a row to mark it */ -}}
{{- $items = append $items (printf "\n%s + sml::on_entry<sml::_> / [] {}" $first) -}}
{{- end -}}
{{- if $items -}}
{{- $items = prepend (rest $items) (print $comments (first $items)) -}}
{{- else -}}
{{- $items = list $comments -}}
{{- end -}}
{{- join "⟪row⟫" $items -}}
{{- end -}}

{{- define "stateComments" -}}{{- /* . = *State: its stereotype, note, invariant and variables as comments before its rows */ -}}
{{- $lines := list -}}
{{- with .Stereotype }}{{ $lines = append $lines (printf "«%s»" .) }}{{ end -}}
{{- with .Note }}{{ $lines = append $lines . }}{{ end -}}
{{- with .Invariant }}{{ $lines = append $lines (printf "invariant: %s" .) }}{{ end -}}
{{- with .InvariantNote }}{{ $lines = append $lines . }}{{ end -}}
{{- range .Variables }}{{ $lines = append $lines (printf "variable: %s%s" .Name (prefix " = " .Value)) }}{{ end -}}
{{- if $lines -}}
{{- $lines = prepend $lines (printf "%s:" .Name) -}}
{{- include "comment" (join "\n" $lines) -}}
{{- end -}}
{{- end -}}

{{- define "stateRows" -}}{{- /* . = *State: its behaviours and the transitions leaving it, sources written ⟨src⟩, separated by ⟪row⟫ */ -}}
{{- $s := . -}}
{{- $out := list -}}
{{- $region := include "isRegion" $s.Name -}}
{{- if and $s.IsPseudo (or $s.OnEntry $s.OnExit) -}}
{{- warn "state %q: Boost.SML's final state X has no entry or exit behaviour; it is not written" $s.Name -}}
{{- else -}}
{{- with $s.OnEntry }}{{ $out = append $out (printf "%s\n⟨src⟩ + sml::on_entry<sml::_>%s" (include "comment" $s.EntryNote) (include "actions" (dict "list" . "what" (printf "the entry behaviour of %q" $s.Name)))) }}{{ end -}}
{{- with $s.OnExit }}{{ $out = append $out (printf "%s\n⟨src⟩ + sml::on_exit<sml::_>%s" (include "comment" $s.ExitNote) (include "actions" (dict "list" . "what" (printf "the exit behaviour of %q" $s.Name)))) }}{{ end -}}
{{- end -}}
{{- with $s.Do -}}
{{- warn "state %q: Boost.SML has no do activities; %s is written as a comment" $s.Name (join ", " .) -}}
{{- $out = append $out (include "comment" (joinNonEmpty "\n" (printf "do / %s" (join ", " .)) $s.DoNote)) -}}
{{- end -}}
{{- range $s.Defer -}}
{{- $out = append $out (printf "%s\n⟨src⟩ + sml::event<⟨e:%s⟩> / sml::defer" (include "comment" (index $s.DeferNotes .)) (include "cid" .)) -}}
{{- end -}}
{{- include "pseudoWarnings" $s -}}
{{- if $s.Submachine }}{{ range Children $s.Name }}{{ include "pseudoWarnings" . }}{{ end }}{{ end -}}
{{- /* transitions whose lifted source is this state, an else branch after its siblings */ -}}
{{- $else := list -}}
{{- range $t := Transitions -}}
{{- $lift := include "lift" $t -}}
{{- if $lift -}}
{{- $parts := splitList "\t" $lift -}}
{{- $src := index $parts 1 -}}
{{- $effSrc := index $parts 3 -}}
{{- $completion := not (or $t.Event $t.After) -}}
{{- $row := "" -}}
{{- if and (eq $src $s.Name) (ne $src $effSrc) $completion -}}
{{- /* a completion transition from inside: the inside ends (X), which completes this state */ -}}
{{- if eq (include "tableOf" $effSrc) $src -}}
{{- $row = include "row" (dict "t" $t "parts" $parts "mode" "outer") -}}
{{- else -}}
{{- warn "transition %s -> %s: Boost.SML has no transitions from inside a composite state, and %q lies too deep inside %q to complete it; it is not written" $t.Source (join " " $t.Targets) $t.Source $src -}}
{{- end -}}
{{- else if eq $src $s.Name -}}
{{- $row = include "row" (dict "t" $t "parts" $parts "mode" "") -}}
{{- else if and (eq $effSrc $s.Name) $completion (eq (include "tableOf" $effSrc) $src) -}}
{{- $row = include "row" (dict "t" $t "parts" $parts "mode" "inner") -}}
{{- end -}}
{{- if not $row -}}
{{- else if eq $t.Cond "else" }}{{ $else = append $else $row }}{{ else }}{{ $out = append $out $row }}{{ end -}}
{{- end -}}
{{- end -}}
{{- join "⟪row⟫" (concat $out $else) -}}
{{- end -}}

{{- define "pseudoWarnings" -}}{{- /* . = *State: the kinds SML has no counterpart for */ -}}
{{- $s := . -}}
{{- if .Submachine -}}
{{- warn "state %q: Boost.SML cannot run the machine %q, whose tables are private to its own files; written as a simple state" .Name .Submachine -}}
{{- else if .IsTerminate -}}
{{- warn "state %q: Boost.SML has no terminate; written as X, which ends only its own region" .Name -}}
{{- else if eq .Kind "history-deep" -}}
{{- warn "state %q: Boost.SML has only shallow history; written as a shallow one" .Name -}}
{{- else if eq .Kind "fork" -}}
{{- warn "state %q: Boost.SML has no fork; transitions to it enter %q, whose regions start in their initial states, and its own transitions are not written" .Name (include "forkTarget" .Name) -}}
{{- else if eq .Kind "join" -}}
{{- with include "joinOwner" .Name -}}
{{- warn "state %q: Boost.SML has no join; transitions to it end their region (X), and its outgoing transition is taken once every region of %q has ended" $s.Name . -}}
{{- else -}}
{{- warn "state %q: Boost.SML has no join, and its incoming transitions do not all come from one orthogonal state; the transitions to and from it are not written" $s.Name -}}
{{- end -}}
{{- else if eq .Kind "entry-point" -}}
{{- if .Parent -}}
{{- warn "state %q: Boost.SML has no entry points; transitions to it enter %q at its initial state, and its own transitions are not written" .Name .Parent -}}
{{- else -}}
{{- warn "state %q: Boost.SML has no entry points; it and its transitions are not written" .Name -}}
{{- end -}}
{{- else if eq .Kind "exit-point" -}}
{{- warn "state %q: Boost.SML has no exit points; the transitions to and from it are not written" .Name -}}
{{- end -}}
{{- if .IsHistory -}}
{{- range OutgoingTransitions .Name -}}
{{- $scope := State $s.Parent -}}
{{- if or (ne (join " " .Targets) (default "" $scope.Initial)) .Actions -}}
{{- warn "state %q: Boost.SML resumes a history in its region's initial state the first time; the default transition to %s is not written" $s.Name (join " " .Targets) -}}
{{- end -}}
{{- end -}}
{{- end -}}
{{- end -}}

{{- define "row" -}}{{- /* . = dict "t" *Transition "parts" its lift "mode" "", or "inner" and "outer" for the two rows of a completion transition from inside a composite state: the row, source written ⟨src⟩ */ -}}
{{- $t := .t -}}
{{- $mode := .mode -}}
{{- $src := index .parts 1 -}}
{{- $tgt := index .parts 2 -}}
{{- $effSrc := index .parts 3 -}}
{{- $effTgt := index .parts 4 -}}
{{- $label := printf "transition %s -> %s" $t.Source (join " " $t.Targets) -}}
{{- if ne $mode "inner" -}}
{{- if gt (len $t.Targets) 1 -}}
{{- warn "%s: a Boost.SML transition has one target; only %s is written" $label (first $t.Targets) -}}
{{- end -}}
{{- if eq $mode "outer" -}}
{{- warn "%s: Boost.SML has no transitions from inside a composite state; written as %q going to X, which completes %q, and a completion transition of %q" $label $effSrc $src $src -}}
{{- else if ne $src $effSrc -}}
{{- warn "%s: Boost.SML has no transitions from inside a composite state; written as a transition of %q" $label $src -}}
{{- end -}}
{{- if and $tgt (ne $tgt $effTgt) -}}
{{- warn "%s: Boost.SML has no transitions into a composite state; it enters %q at its initial state" $label $tgt -}}
{{- else if and $tgt (HistoryOf $tgt) (eq (first $t.Targets) $tgt) -}}
{{- warn "%s: %q has a history, so Boost.SML resumes it here too" $label $tgt -}}
{{- end -}}
{{- if $t.IsLocal -}}
{{- warn "%s: Boost.SML has no local transitions; written as an external one" $label -}}
{{- end -}}
{{- end -}}
{{- $trigger := "" -}}
{{- if $t.After -}}
{{- $trigger = printf " + sml::event<⟨e:%s⟩>" (include "afterEvent" $t.After) -}}
{{- warn "%s: Boost.SML has no time triggers; written on the event %s, which the application raises %s after entering %s" $label (include "afterEvent" $t.After) $t.After $t.Source -}}
{{- else if $t.Event -}}
{{- $trigger = printf " + sml::event<⟨e:%s⟩>" (include "cid" $t.Event) -}}
{{- end -}}
{{- $guard := "" -}}
{{- $bad := false -}}
{{- if and $t.Cond (ne $t.Cond "else") (ne $mode "outer") -}}
{{- if regexMatch "^[A-Za-z0-9_()! \t\n]*$" $t.Cond -}}
{{- $guard = regexReplaceAll "[A-Za-z_][A-Za-z0-9_]*" $t.Cond "⟨g:$0⟩" | replace "⟨g:and⟩" "&&" | replace "⟨g:or⟩" "||" -}}
{{- $guard = printf " [%s]" (regexReplaceAll "⟨g:not⟩\\s*" $guard "!") -}}
{{- else -}}
{{- $bad = true -}}
{{- $guard = printf " [%s]" $t.Cond -}}
{{- warn "%s: the guard [%s] is not made of names; the transition is written as a comment" $label $t.Cond -}}
{{- end -}}
{{- end -}}
{{- $row := "" -}}
{{- if eq $mode "inner" -}}
{{- $row = printf "⟨src⟩%s = sml::X" $guard -}}
{{- else -}}
{{- $row = printf "⟨src⟩%s%s%s" $trigger $guard (include "actions" (dict "list" $t.Actions "what" $label)) -}}
{{- if $tgt }}{{ $row = printf "%s = %s" $row (include "ref" $tgt) }}{{ else if not $t.Actions }}{{ $row = print $row " / [] {}" }}{{ end -}}
{{- include "comment" $t.Note -}}
{{- end -}}
{{- if $bad }}
// {{ $row }}
{{- else }}
{{ $row }}
{{- end -}}
{{- end -}}

{{- define "actions" -}}{{- /* . = dict "list" actions "what" whose: " / a" or " / (a, b)", names only */ -}}
{{- $names := list -}}
{{- $what := .what -}}
{{- range .list -}}
{{- if regexMatch "^[A-Za-z_][A-Za-z0-9_]*$" . -}}
{{- $names = append $names (printf "⟨a:%s⟩" .) -}}
{{- else -}}
{{- warn "%s: the action %q is not a name; it is not written" $what . -}}
{{- end -}}
{{- end -}}
{{- if eq (len $names) 1 }} / {{ first $names }}
{{- else if $names }} / ({{ join ", " $names }})
{{- else if .list }} / [] {}
{{- end -}}
{{- end -}}

{{- define "lift" -}}{{- /* . = *Transition: "table<TAB>source<TAB>target<TAB>its source<TAB>its target" in the innermost table holding both ends, or "" when it is not written */ -}}
{{- $t := . -}}
{{- $s := State .Source -}}
{{- $effSrc := .Source -}}
{{- $skip := or $s.IsHistory (eq $s.Kind "entry-point" "exit-point" "fork") -}}
{{- if eq $s.Kind "join" }}{{ $effSrc = include "joinOwner" .Source }}{{ $skip = not $effSrc }}{{ end -}}
{{- $effTgt := "" -}}
{{- $tChain := "" -}}
{{- with .Targets -}}
{{- $tg := State (first .) -}}
{{- $effTgt = $tg.Name -}}
{{- if $tg.IsHistory -}}{{- $effTgt = $tg.Parent -}}
{{- else if eq $tg.Kind "entry-point" -}}{{- $effTgt = $tg.Parent -}}{{- $skip = or $skip (not $tg.Parent) -}}
{{- else if eq $tg.Kind "exit-point" -}}{{- $skip = true -}}
{{- else if eq $tg.Kind "fork" -}}{{- $effTgt = include "forkTarget" $tg.Name -}}
{{- else if eq $tg.Kind "join" -}}
{{- with include "joinOwner" $tg.Name -}}
{{- $effTgt = "⟨X⟩" -}}{{- $tChain = printf "⟨X⟩\t%s\n%s" . (include "chain" .) -}}
{{- else -}}{{- $skip = true -}}{{- end -}}
{{- end -}}
{{- if and (not $tChain) (not $skip) }}{{ $tChain = include "chain" $effTgt }}{{ end -}}
{{- else -}}
{{- $tChain = include "chain" $effSrc -}}
{{- end -}}
{{- if not $skip -}}
{{- $found := "" -}}
{{- range $sl := include "chain" $effSrc | splitList "\n" -}}
{{- if not $found -}}
{{- range $tl := splitList "\n" $tChain -}}
{{- if and (not $found) (eq (last (splitList "\t" $sl)) (last (splitList "\t" $tl))) -}}
{{- $found = printf "%s\t%s\t%s" (last (splitList "\t" $sl)) (first (splitList "\t" $sl)) (ternary (first (splitList "\t" $tl)) "" (not (not $t.Targets))) -}}
{{- end -}}
{{- end -}}
{{- end -}}
{{- end -}}
{{- with $found }}{{ printf "%s\t%s\t%s" . $effSrc $effTgt }}{{ end -}}
{{- end -}}
{{- end -}}

{{- define "chain" -}}{{- /* . = state name: lines "state<TAB>its table" for it and each ancestor that is a state of some table */ -}}
{{- $lines := list -}}
{{- range prepend (Ancestors .) . -}}
{{- if not (include "isRegion" .) }}{{ $lines = append $lines (printf "%s\t%s" . (include "tableOf" .)) }}{{ end -}}
{{- end -}}
{{- join "\n" $lines -}}
{{- end -}}

{{- define "forkTarget" -}}{{- /* . = fork name: the state its transitions enter together */ -}}
{{- $targets := list -}}
{{- range OutgoingTransitions . }}{{ $targets = concat $targets .Targets }}{{ end -}}
{{- $common := include "commonAncestor" $targets -}}
{{- if include "isRegion" $common }}{{ $common = (State $common).Parent }}{{ end -}}
{{- $common -}}
{{- end -}}

{{- define "joinOwner" -}}{{- /* . = join name: the orthogonal state its incoming transitions all come from, or "" */ -}}
{{- $sources := list -}}
{{- range IncomingTransitions . }}{{ $sources = append $sources .Source }}{{ end -}}
{{- $p := include "commonAncestor" $sources -}}
{{- if include "isRegion" $p }}{{ $p = (State $p).Parent }}{{ end -}}
{{- with State $p }}{{ if .IsParallel }}{{ .Name }}{{ end }}{{ end -}}
{{- end -}}

{{- define "commonAncestor" -}}{{- /* . = list of state names: the innermost state containing them all, "" for none */ -}}
{{- $names := . -}}
{{- $found := "" -}}
{{- if $names -}}
{{- range $a := Ancestors (first $names) -}}
{{- if not $found -}}
{{- $all := true -}}
{{- range rest $names }}{{ if not (has $a (Ancestors .)) }}{{ $all = false }}{{ end }}{{ end -}}
{{- if $all }}{{ $found = $a }}{{ end -}}
{{- end -}}
{{- end -}}
{{- end -}}
{{- $found -}}
{{- end -}}

{{- define "tableOf" -}}{{- /* . = state name: the table its rows go in, "" for the machine's; a region's states go in the orthogonal state's */ -}}
{{- $s := State . -}}
{{- if include "isRegion" $s.Parent }}{{ (State $s.Parent).Parent }}{{ else }}{{ $s.Parent }}{{ end -}}
{{- end -}}

{{- define "isRegion" -}}{{- /* . = state name: non-empty for a region with states of its own, which SML flattens into its orthogonal state */ -}}
{{- $s := State . -}}
{{- if and $s $s.IsNormal (not $s.Submachine) (Children .) $s.Parent (State $s.Parent).IsParallel }}region{{ end -}}
{{- end -}}

{{- define "isStruct" -}}{{- /* . = state name: non-empty when the state gets a struct of its own */ -}}
{{- $s := State . -}}
{{- if and (not (include "isRegion" .)) (not $s.Submachine) (or $s.IsParallel (and $s.IsNormal (Children .))) }}struct{{ end -}}
{{- end -}}

{{- define "ref" -}}{{- /* . = state name, "⟨X⟩" for a region's end: the state as SML writes it */ -}}
{{- $s := State . -}}
{{- if or (eq . "⟨X⟩") $s.IsFinal $s.IsTerminate }}sml::X
{{- else if include "isStruct" . }}sml::state<⟨s:{{ include "sid" . }}⟩>
{{- else }}{{ include "str" . }}
{{- end -}}
{{- end -}}

{{- define "sid" -}}{{- /* . = state name: its struct's name, kept apart from the names the file defines */ -}}
{{- $id := include "cid" . -}}
{{- if has $id (list "machine" "sml" "event") }}{{ $id }}_state{{ else }}{{ $id }}{{ end -}}
{{- end -}}

{{- define "eventIds" -}}{{- /* . = anything: every event's struct name, one per line, in order of first use */ -}}
{{- $ids := list -}}
{{- range States }}{{ range .Defer }}{{ $ids = append $ids (include "cid" .) }}{{ end }}{{ end -}}
{{- range Transitions -}}
{{- if .After }}{{ $ids = append $ids (include "afterEvent" .After) }}{{ else if .Event }}{{ $ids = append $ids (include "cid" .Event) }}{{ end -}}
{{- end -}}
{{- join "\n" (uniq $ids) -}}
{{- end -}}

{{- define "pascal" -}}{{- /* . = machine name: its words run together, each capitalised, "Machine" when it has none */ -}}
{{- $words := list -}}
{{- range regexSplit "[^A-Za-z0-9]+" (default "" .) -1 }}{{ if . }}{{ $words = append $words (print (upper (substr 0 1 .)) (substr 1 -1 .)) }}{{ end }}{{ end -}}
{{- $name := default "Machine" (join "" $words) -}}
{{- if regexMatch "^[0-9]" $name }}_{{ end }}{{ $name -}}
{{- end -}}

{{- define "afterEvent" -}}{{- /* . = delay: the event a time trigger waits for */ -}}
{{- print "after_" . | include "cid" -}}
{{- end -}}

{{- define "cid" -}}{{- /* . = name, as a C++ identifier */ -}}
{{- $id := regexReplaceAll "[^A-Za-z0-9_]" . "_" -}}
{{- if regexMatch "^[0-9]" $id }}_{{ end }}{{ $id -}}
{{- end -}}

{{- define "str" -}}{{- /* . = state name, as an SML string-literal state */ -}}
"{{ replace "\\" "\\\\" . | replace "\"" "\\\"" }}"_s
{{- end -}}

{{- define "comment" -}}{{- /* . = text: one // line per line, each starting with a newline; nothing when empty */ -}}
{{- if . -}}
{{- range splitList "\n" . }}
//{{ prefix " " . }}
{{- end -}}
{{- end -}}
{{- end -}}

{{- define "oneLine" -}}{{- /* . = text: line breaks become spaces */ -}}
{{- replace "\n" " " . -}}
{{- end -}}
