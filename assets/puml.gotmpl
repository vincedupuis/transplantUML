{{- /*
PlantUML state diagram.

"." at the top level is the *model.StateMachine. Every emitted line starts with
a newline so that nested blocks can be assembled with `include ... | indent`.

Every state of the model is declared with a `state` line under its own name,
so behaviours and notes can attach to any of them: final states are
<<end>>, history states <<history>> / <<history*>>, the connectors
<<choice>>, <<fork>>, <<join>>, <<entryPoint>>, <<exitPoint>> (a junction is
the filled circle of <<start>>), and the initial state is the only thing
drawn with [*]. Names PlantUML would misread (a dot nests, a dash breaks) get
an alias: `state "a.b" as a_b`. A user stereotype is kept as <<stereotype>>
for skinparams and shown as «stereotype» in the label, since PlantUML does
not print it. Parallel regions are separated with "--". State behaviours
(entry/do/exit, deferred events, invariant, variables) are description lines;
on a final state, which ignores them, they go into its note. The notes on
those behaviours join the state's own note, each labelled with what it
describes.

Each scope (the top level, a compound state's braces, a parallel region)
declares its states first and draws transitions after them, and a transition
is drawn in the innermost scope that contains both its ends: PlantUML creates
a state where it first sees its name, so an arrow to a nested state that has
not been declared yet would create a copy in the wrong place, and an arrow
between states of a parallel region is only accepted inside that region.
Arrows that cross the boundary of any region but the first are refused by
PlantUML altogether.

What PlantUML cannot draw as the model means it raises a warning and is said
in a note instead: on the state concerned, or on the parallel state for what
belongs to one of its anonymous regions.
*/ -}}
@startuml
{{- with .Name }}
title {{ . }}
{{- end -}}
{{- template "machineNote" . -}}
{{- template "legend" . -}}
{{- template "scope" "" }}
@enduml
{{ "" -}}

{{- define "scope" -}}{{- /* . = scope name ("" = top level): its initial, its states, then its transitions */ -}}
{{- with InitialOf . }}
[*] --> {{ template "id" . }}{{ with InitialActionsOf $ }}: {{ prefix "/ " (join "; " .) | include "text" }}{{ end }}
{{- end -}}
{{- range Children . -}}
{{- template "state" . -}}
{{- end -}}
{{- template "scopeTransitions" . -}}
{{- end -}}

{{- define "state" -}}{{- /* . = *State */ -}}
{{- if .IsTerminate -}}
{{- warn "state %q: PlantUML has no terminate symbol; drawn as a final state, which its note calls a terminate" .Name -}}
{{- end -}}
{{- if .IsParallel }}
state {{ template "decl" . }} {
{{ include "regions" .Name | trimPrefix "\n" | indent 4 }}
}
{{- else if Children .Name }}
state {{ template "decl" . }} {
{{ include "scope" .Name | trimPrefix "\n" | indent 4 }}
}
{{- else }}
state {{ template "decl" . }}
{{- end -}}
{{- template "details" . -}}
{{- end -}}

{{- define "decl" -}}{{- /* . = *State: what follows `state`: label, alias and stereotype */ -}}
{{- $id := include "id" .Name -}}
{{- $label := .Name -}}
{{- with .Submachine }}{{ $label = printf "%s: %s" $label . }}{{ end -}}
{{- if and .Stereotype (not .IsPseudo) }}{{ $label = printf "«%s»\\n%s" .Stereotype $label }}{{ end -}}
{{- if ne $label $id }}"{{ $label }}" as {{ end }}{{ $id }}
{{- if .IsPseudo }} <<{{ template "stereotype" .Kind }}>>
{{- with .Stereotype }}{{ warn "state %q: PlantUML allows one stereotype per state; «%s» goes into its note" $.Name . }}{{ end -}}
{{- else }}{{ with .Stereotype }} <<{{ . }}>>{{ end }}{{ end -}}
{{- end -}}

{{- define "stereotype" -}}{{- /* . = pseudo-state StateKind */ -}}
{{- if eq . "final" "terminate" }}end
{{- else if eq . "history-shallow" }}history
{{- else if eq . "history-deep" }}history*
{{- else if eq . "choice" }}choice
{{- else if eq . "junction" }}start
{{- else if eq . "fork" }}fork
{{- else if eq . "join" }}join
{{- else if eq . "entry-point" }}entryPoint
{{- else if eq . "exit-point" }}exitPoint
{{- end -}}
{{- end -}}

{{- define "regions" -}}{{- /* . = parallel state name: each child is a region, drawn as its body */ -}}
{{- range $i, $region := Children . -}}
{{- if $i }}
--
{{- end -}}
{{- if include "isRegion" $region.Name -}}
{{- if or $region.OnEntry $region.OnExit $region.Do $region.Defer $region.Invariant $region.Variables $region.Stereotype $region.Note $region.Submachine -}}
{{- warn "region %q: PlantUML regions are anonymous; its behaviours, stereotype and note join the note on %q" $region.Name $region.Parent -}}
{{- end -}}
{{- template "scope" $region.Name -}}
{{- else -}}
{{- /* a region with no substates (or one that is itself orthogonal) is drawn as the state itself */ -}}
{{- template "state" $region -}}
{{- end -}}
{{- end -}}
{{- template "scopeTransitions" . -}}
{{- end -}}

{{- define "isRegion" -}}{{- /* . = state name: non-empty when it is a compound region, drawn as a body without a name of its own */ -}}
{{- $s := State . -}}
{{- if and $s $s.IsNormal (Children .) $s.Parent (State $s.Parent).IsParallel }}region{{ end -}}
{{- end -}}

{{- define "details" -}}{{- /* . = *State: behaviours as description lines, then the note */ -}}
{{- $id := include "id" .Name -}}
{{- if or .IsFinal .IsTerminate -}}
{{- /* PlantUML ignores description lines on an <<end>> state; the note carries them instead */ -}}
{{- $lines := list -}}
{{- if .IsTerminate }}{{ $lines = append $lines "terminate, drawn as a final state" }}{{ end -}}
{{- with .Stereotype }}{{ $lines = append $lines (printf "«%s»" .) }}{{ end -}}
{{- range .OnEntry }}{{ $lines = append $lines (printf "entry / %s" .) }}{{ end -}}
{{- range .OnExit }}{{ $lines = append $lines (printf "exit / %s" .) }}{{ end -}}
{{- with include "stateNote" . }}{{ $lines = append $lines . }}{{ end -}}
{{- template "note" (dict "id" $id "text" (join "\n" $lines)) -}}
{{- else if .IsPseudo -}}
{{- template "note" (dict "id" $id "text" (joinNonEmpty "\n" (surround "«" .Stereotype "»") (include "stateNote" .))) -}}
{{- else -}}
{{- range .OnEntry }}
{{ $id }} : entry / {{ template "text" . }}
{{- end -}}
{{- range .Do }}
{{ $id }} : do / {{ template "text" . }}
{{- end -}}
{{- range .OnExit }}
{{ $id }} : exit / {{ template "text" . }}
{{- end -}}
{{- range .Defer }}
{{ $id }} : {{ template "text" . }} / defer
{{- end -}}
{{- with .Invariant }}
{{ $id }} : [ {{ template "text" . }} ]
{{- end -}}
{{- range .Variables }}
{{ $id }} : {{ .Name }}{{ prefix " = " .Value | include "text" }}
{{- end -}}
{{- template "note" (dict "id" $id "text" (include "stateNote" .)) -}}
{{- end -}}
{{- end -}}

{{- define "stateNote" -}}{{- /* . = *State: its note, then the notes on its behaviours, invariant and deferred events, which PlantUML cannot attach to a description line */ -}}
{{- $lines := list -}}
{{- with .Note }}{{ $lines = append $lines . }}{{ end -}}
{{- with .EntryNote }}{{ $lines = append $lines (printf "entry: %s" .) }}{{ end -}}
{{- with .DoNote }}{{ $lines = append $lines (printf "do: %s" .) }}{{ end -}}
{{- with .ExitNote }}{{ $lines = append $lines (printf "exit: %s" .) }}{{ end -}}
{{- range $event, $note := .DeferNotes }}{{ $lines = append $lines (printf "%s / defer: %s" $event $note) }}{{ end -}}
{{- with .InvariantNote }}{{ $lines = append $lines (printf "invariant: %s" .) }}{{ end -}}
{{- with include "undrawn" . }}{{ $lines = append $lines . }}{{ end -}}
{{- if .IsParallel -}}
{{- range Children .Name -}}
{{- if include "isRegion" .Name -}}
{{- $region := .Name -}}
{{- range splitList "\n" (include "regionLines" .) }}{{ if . }}{{ $lines = append $lines (printf "region %s: %s" $region .) }}{{ end }}{{ end -}}
{{- end -}}
{{- end -}}
{{- end -}}
{{- join "\n" $lines -}}
{{- end -}}

{{- define "undrawn" -}}{{- /* . = *State that is not a region: its transitions PlantUML cannot draw, one line each */ -}}
{{- $lines := list -}}
{{- range $t := OutgoingTransitions .Name -}}
{{- if or $t.IsInternal (not $t.Targets) -}}
{{- with $t.Note }}{{ $lines = append $lines (printf "%s: %s" (default "internal transition" $t.Trigger) .) }}{{ end -}}
{{- else -}}
{{- range $target := $t.Targets -}}
{{- if include "unreachable" (dict "t" $t "target" $target) -}}
{{- $lines = append $lines (printf "not drawn: --> %s%s" $target (prefix ": " (include "plainLabel" $t))) -}}
{{- end -}}
{{- end -}}
{{- end -}}
{{- end -}}
{{- join "\n" $lines -}}
{{- end -}}

{{- define "regionLines" -}}{{- /* . = *State, a compound region: what its anonymous body cannot show, one line each */ -}}
{{- $lines := list -}}
{{- with .Stereotype }}{{ $lines = append $lines (printf "«%s»" .) }}{{ end -}}
{{- with .Submachine }}{{ $lines = append $lines (printf "submachine %s" .) }}{{ end -}}
{{- range .OnEntry }}{{ $lines = append $lines (printf "entry / %s" .) }}{{ end -}}
{{- range .Do }}{{ $lines = append $lines (printf "do / %s" .) }}{{ end -}}
{{- range .OnExit }}{{ $lines = append $lines (printf "exit / %s" .) }}{{ end -}}
{{- range .Defer }}{{ $lines = append $lines (printf "%s / defer" .) }}{{ end -}}
{{- with .Invariant }}{{ $lines = append $lines (printf "[ %s ]" .) }}{{ end -}}
{{- range .Variables }}{{ $lines = append $lines (printf "%s%s" .Name (prefix " = " .Value)) }}{{ end -}}
{{- with .Note }}{{ $lines = append $lines (replace "\n" " " .) }}{{ end -}}
{{- range $t := OutgoingTransitions .Name -}}
{{- if or $t.IsInternal (not $t.Targets) -}}
{{- $lines = append $lines (include "plainLabel" $t) -}}
{{- else -}}
{{- range $t.Targets }}{{ $lines = append $lines (printf "--> %s%s" . (prefix ": " (include "plainLabel" $t))) }}{{ end -}}
{{- end -}}
{{- end -}}
{{- join "\n" $lines -}}
{{- end -}}

{{- define "unreachable" -}}{{- /* . = dict "t" *Transition "target" name: why PlantUML cannot draw the arrow, or "" */ -}}
{{- $scope := ScopeOf .t -}}
{{- if include "isRegion" .target }}region
{{- else if or (include "confined" (dict "state" .t.Source "scope" $scope)) (include "confined" (dict "state" .target "scope" $scope)) }}confined
{{- end -}}
{{- end -}}

{{- define "plainLabel" -}}{{- /* . = *Transition: "trigger [cond] / actions" on one line, for a note */ -}}
{{- joinNonEmpty " " .Trigger (surround "[" .Cond "]") (prefix "/ " (join ", " .Actions)) -}}
{{- end -}}

{{- define "note" -}}{{- /* . = dict "id" state alias "text" note text (nothing drawn when empty) */ -}}
{{- if not .text -}}
{{- else if contains "\n" .text }}
note right of {{ .id }}
{{ indent 4 .text }}
end note
{{- else }}
note right of {{ .id }} : {{ .text }}
{{- end -}}
{{- end -}}

{{- define "machineNote" -}}{{- /* . = *StateMachine */ -}}
{{- with .Note }}
note as machineNote
{{ indent 4 . }}
end note
{{- end -}}
{{- end -}}

{{- define "legend" -}}{{- /* . = *StateMachine: its variables */ -}}
{{- with .Variables }}
legend
{{- range . }}
    {{ .Name }}{{ prefix " = " .Value }}
{{- end }}
endlegend
{{- end -}}
{{- end -}}

{{- define "scopeTransitions" -}}{{- /* . = scope name ("" = top level): the transitions whose ends all lie in it */ -}}
{{- $scope := . -}}
{{- range $s := States -}}
{{- range $t := OutgoingTransitions $s.Name -}}
{{- if eq (ScopeOf $t) $scope -}}{{- template "transition" $t -}}{{- end -}}
{{- end -}}
{{- end -}}
{{- end -}}

{{- define "transition" -}}{{- /* . = *Transition, drawn in the scope of its common ancestor */ -}}
{{- $t := . -}}
{{- $scope := ScopeOf . -}}
{{- if include "isRegion" .Source -}}
{{- warn "region %q: PlantUML regions are anonymous; its transition (%s) is not drawn, and a note on %q says it" .Source (include "labelText" $t) (State .Source).Parent -}}
{{- else if or .IsInternal (not .Targets) }}
{{ template "id" .Source }} : {{ template "labelText" . }}
{{- with .Note -}}{{- warn "transition %s (%s): PlantUML cannot attach a note to an internal transition; it joins the note on %q" $t.Source $t.Trigger $t.Source -}}{{- end -}}
{{- else -}}
{{- if .IsLocal -}}{{- warn "transition %s -> %s: PlantUML has no local transitions; drawn as an external one marked «local»" .Source (join " " .Targets) -}}{{- end -}}
{{- range $i, $target := .Targets -}}
{{- $why := include "unreachable" (dict "t" $t "target" $target) -}}
{{- if eq $why "region" -}}
{{- warn "region %q: PlantUML regions are anonymous; the transition %s -> %s into it is not drawn, and a note on %q says it" $target $t.Source $target $t.Source -}}
{{- else if $why -}}
{{- warn "transition %s -> %s: PlantUML cannot draw arrows across the boundary of a parallel region other than the first; a note on %q says it" $t.Source $target $t.Source -}}
{{- else }}
{{ template "id" $t.Source }} --> {{ template "id" $target }}{{ with joinNonEmpty "\\n" (include "labelText" $t) (ternary "«local»" "" $t.IsLocal) }}: {{ . }}{{ end }}
{{- if and (not $i) $t.Note -}}{{- template "linkNote" $t.Note -}}{{- end -}}
{{- end -}}
{{- end -}}
{{- end -}}
{{- end -}}

{{- define "confined" -}}{{- /* . = dict "state" name "scope" name: non-empty when a region other than the first of its parallel state lies between the state (inclusive) and the scope */ -}}
{{- $scope := .scope -}}
{{- range $name := prepend (Ancestors .state) .state -}}
{{- if eq $name $scope -}}{{- break -}}{{- end -}}
{{- $s := State $name -}}
{{- $p := State $s.Parent -}}
{{- if and $p $p.IsParallel (ne (index (Children $p.Name) 0).Name $name) }}{{ $name }}{{ break }}{{ end -}}
{{- end -}}
{{- end -}}

{{- define "linkNote" -}}{{- /* . = note text, attached to the arrow just drawn */ -}}
{{- if contains "\n" . }}
note on link
{{ indent 4 . }}
end note
{{- else }}
note on link : {{ . }}
{{- end -}}
{{- end -}}

{{- define "labelText" -}}{{- /* . = *Transition: "trigger [ cond ] / actions", parts on their own lines */ -}}
{{- joinNonEmpty "\\n" .Trigger (surround "[ " .Cond " ]") (prefix "/ " (join "; " .Actions)) | include "text" -}}
{{- end -}}

{{- define "id" -}}{{- /* . = state name, as a PlantUML identifier: anything else would be read as nesting or an arrow */ -}}
{{- regexReplaceAll "[^A-Za-z0-9_]" . "_" -}}
{{- end -}}

{{- define "text" -}}{{- /* . = free text on one PlantUML line: real line breaks become \n */ -}}
{{- replace "\n" "\\n" . -}}
{{- end -}}
