<?xml version="1.0" encoding="UTF-8"?>
<!--
  Choice, junction, submachine state, do activity, terminate and stereotypes.

  "check" needs no markup: a state with nothing but guarded eventless
  transitions is the SCXML idiom for a choice. The junction has no idiom, so it
  is marked tpuml:kind="junction". Invoking another SCXML document makes
  "payment" a submachine state; invoking anything else is a do activity.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:tpuml="https://github.com/vincedupuis/transplantUML"
       version="1.0" name="order" initial="new">
  <datamodel>
    <data id="total" expr="0"/>
    <data id="attempts" expr="0"/>
  </datamodel>

  <state id="new">
    <transition event="submit" target="check"/>
  </state>

  <state id="check">
    <transition cond="isEmpty" target="rejected"/>
    <transition cond="isLarge" target="review"/>
    <transition cond="not (isEmpty or isLarge)" target="payment"/>
  </state>

  <state id="review" tpuml:stereotype="manual">
    <tpuml:note>A human approves large orders.</tpuml:note>
    <invoke type="tpuml:do" src="reviewTicket"/>
    <transition event="approve" target="payment"/>
    <transition event="reject" target="rejected"/>
  </state>

  <state id="payment">
    <invoke src="payment"/>
    <transition event="done.invoke" target="paid"/>
    <transition event="error.payment" target="retry">
      <script>countAttempt</script>
    </transition>
  </state>

  <!-- A junction: the same guarded branching as a choice, but the guards are
       static, evaluated before the compound transition starts. -->
  <state id="retry" tpuml:kind="junction">
    <transition cond="canRetry" target="payment"/>
    <transition cond="not canRetry" target="rejected"/>
  </state>

  <state id="paid">
    <onentry><script>confirmOrder</script></onentry>
    <transition event="ship" target="shipped"/>
    <transition event="fraud" target="killed"/>
  </state>

  <final id="shipped"/>
  <final id="rejected"/>
  <!-- Terminate: the machine stops on the spot, no exit actions run. -->
  <final id="killed" tpuml:kind="terminate"/>
</scxml>
