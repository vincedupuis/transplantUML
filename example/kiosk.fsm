# Nested states interleaved with the transitions that concern them, the initial
# child of each compound state, entry, do and exit behaviours, deferred events,
# state invariants, boolean guards, time triggers on a delay and on a computed
# one, external, local and internal transitions, and every form a goto target
# can take: a state name, "final" and "H".

fsm kiosk {
  initial state idle {
    entry / dim
    on touch / wake goto browsing
  }

  state ordering {
    entry / newBasket
    exit / clearBasket, unlock
    on abandon goto idle
    after(90s) goto idle

    initial state browsing {
      on add [inStock and (card or cash)] / addLine
      on remove / dropLine goto browsing
      on checkout [basket] goto paying
    }

    state paying {
      entry / lockBasket
      invariant [basket and not (card and cash)]
      on approved / receipt goto done
      on declined [retries] / warn goto again
      on declined [not retries] goto browsing

      initial state authorizing {
        do / spin
        on touch / defer
        on cancel goto browsing
        after(authTimeout) [retries] / warn goto again
      }

      state again {
        on card goto authorizing
      }
    }

    on resume goto H
    on back goto local browsing
  }

  state done {
    entry / print
    on ack goto final
  }
}
