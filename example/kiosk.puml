@startuml
title kiosk
note as machineNote
    A self-service kiosk:
    browse, pay, take the receipt.
end note
[*] --> idle: / boot
state idle
idle : entry / dim
state ordering {
    [*] --> browsing
    state browsing
    state paying {
        [*] --> authorizing
        state authorizing
        authorizing : do / spin
        authorizing : touch / defer
        note right of authorizing : do: Until the bank answers.
        state again
        authorizing --> again: after(authTimeout)\n[ retries ]\n/ warn
        again --> authorizing: card
    }
    paying : entry / lockBasket
    paying : [ basket and not (card and cash) ]
    note right of paying : The basket is locked from here on.
    state "ordering.H" as ordering_H <<history>>
    browsing : add\n[ inStock and (card or cash) ]\n/ addLine
    browsing --> browsing: remove\n/ dropLine
    browsing --> paying: checkout\n[ basket ]
    paying --> again: declined\n[ retries ]\n/ warn
    paying --> browsing: declined\n[ not retries ]
    authorizing --> browsing: cancel
    ordering_H --> browsing: / greet
}
ordering : entry / newBasket
ordering : exit / clearBasket
ordering : exit / unlock
state done
done : entry / print
state final <<end>>
idle --> browsing: touch\n/ wake
ordering --> idle: abandon
ordering --> idle: after(90s)
note on link : Nobody touched the screen.
ordering --> ordering_H: resume
ordering --> browsing: back
paying --> done: approved\n/ receipt
done --> final: ack
@enduml
