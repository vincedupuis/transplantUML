@startuml
title order
legend
    total = 0
    attempts = 0
endlegend
[*] --> new
state new
state check <<choice>>
state "«manual»\nreview" as review <<manual>>
review : do / reviewTicket
note right of review : A human approves large orders.
state "payment: payment.scxml" as payment
state retry <<start>>
state paid
paid : entry / confirmOrder
state shipped <<end>>
state rejected <<end>>
state killed <<end>>
new --> check: submit
check --> rejected: [ isEmpty ]
check --> review: [ isLarge ]
check --> payment: [ not (isEmpty or isLarge) ]
review --> payment: approve
review --> rejected: reject
payment --> paid
payment --> retry: error.payment\n/ countAttempt
retry --> payment: [ canRetry ]
retry --> rejected: [ not canRetry ]
paid --> shipped: ship
paid --> killed: fraud
@enduml
