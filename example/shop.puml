@startuml
title shop
[*] --> browsing
state reorder <<entryPoint>>
state browsing
state "helpdesk: support" as helpdesk {
    state urgent <<entryPoint>>
    state escalated <<exitPoint>>
}
helpdesk : entry / openChat
state "«secure»\ncheckout" as checkout <<secure>> {
    [*] --> address
    state express <<entryPoint>>
    state cancelled <<exitPoint>>
    state "checkout.H" as checkout_H <<history>>
    note right of checkout_H : Back to the step the customer left.
    state address
    state route <<choice>>
    state review {
        [*] --> depth
        state depth <<choice>>
        state quick
        state thorough
        depth --> quick: [ regular ]
        depth --> thorough: [ else ]
    }
    state paying
    state paid <<start>>
    state "checkout.H-deep" as checkout_H_deep <<history*>>
    express --> paying: / useSavedCard
    address --> route: next\n/ computeTotal
    route --> review: [ large ]
    route --> paying: [ else ]
    review --> paying: approved
    paying --> paid: cash
    paying --> paid: card
    paying --> cancelled: abort
}
state split <<fork>>
note right of split : not drawn: --> invoicing: / notify
state shipping {
    [*] --> packing
    state packing
    state packed
    packing --> packed: packed
    --
    [*] --> invoicing
    state invoicing
    state sent
    note right of sent : not drawn: --> merge: [paidInFull]
    invoicing --> sent: sent
}
state merge <<join>>
state done
state "aftersales: support" as aftersales
state refunded <<end>>
note right of refunded : Money returned.
state terminate <<end>>
note right of terminate
    terminate, drawn as a final state
    Fraud closes the shop.
end note
state final <<end>>
reorder --> checkout: / loadBasket
browsing --> checkout: buy
browsing --> express: quickBuy
browsing --> terminate: fraud
browsing --> helpdesk: help
browsing --> urgent: emergency
helpdesk --> browsing
escalated --> checkout: / page
cancelled --> browsing
paid --> split: / receipt
split --> packing
packed --> merge
merge --> done: / close
done --> checkout_H_deep: reopen
done --> checkout_H: back
done --> refunded: refund
done --> aftersales: complain
done --> final
aftersales --> done
@enduml
