@startuml
title thermostat
note as machineNote
    The model's own JSON shape: every concept, no extension vocabulary needed.
end note
legend
    target = 21
    current = 18
endlegend
[*] --> off
state off
state on {
    [*] --> decide
    state decide <<choice>>
    state "«actuator»\nheating" as heating <<actuator>>
    note right of heating : Burner on.
    state "«actuator»\ncooling" as cooling <<actuator>>
    state steady
    state last <<history>>
    decide --> heating: [ tooCold ]
    decide --> cooling: [ tooWarm ]
    decide --> steady
    heating --> decide: after(60s)
    cooling --> decide: after(60s)
    steady --> decide: after(300s)
    last --> decide
}
on : entry / displayOn
on : do / sampleSensor
on : exit / displayOff
on : schedule / defer
on : [ aboveMinimum ]
state fault <<end>>
off --> on: power
on --> off: power
on --> fault: sensorError
note on link : Unrecoverable.
on : setTarget\n/ setTarget
@enduml
