# Every state kind of the fsm language: a parallel state and its regions, a
# submachine state and the entry and exit points it references, choice and
# junction with an else branch, fork and join, entry and exit points on a state
# and on the machine itself, completion transitions, goto terminate and goto
# final, the shallow and deep history of another state, a named final state, a
# note on an unnamed terminate and on a history, a choice as a state's initial
# child, and a stereotype.

fsm shop {
  entry point reorder / loadBasket goto checkout
  initial state browsing {
    on buy goto checkout
    on quickBuy goto express
    on fraud goto terminate
    on help goto support
    on emergency goto urgent
  }
  submachine support {
    entry / openChat
    entry point urgent
    exit point escalated / page goto checkout
    goto browsing
  }
  state checkout <<secure>> {
    entry point express / useSavedCard goto paying
    exit point cancelled goto browsing
    | Back to the step the customer left. |
    H
    initial state address { on next / computeTotal goto route }
    choice route {
      [large] goto review
      [else] goto paying
    }
    state review {
      on approved goto paying
      initial choice depth {
        [regular] goto quick
        [else] goto thorough
      }
      state quick {}
      state thorough {}
    }
    state paying {
      on cash goto paid
      on card goto paid
      on abort goto cancelled
    }
    junction paid / receipt goto split
  }
  fork split {
    goto packing
    / notify goto invoicing
  }
  parallel state shipping {
    region warehouse {
      initial state packing { on packed goto packed }
      state packed { goto merge }
    }
    region accounting {
      initial state invoicing { on sent goto sent }
      state sent { [paidInFull] goto merge }
    }
  }
  join merge / close goto done
  state done {
    on reopen goto checkout.H*
    on back goto checkout.H
    on refund goto refunded
    goto final
  }
  | Money returned. |
  final state refunded
  | Fraud closes the shop. |
  terminate state
}
